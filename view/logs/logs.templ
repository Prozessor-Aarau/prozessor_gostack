package logs

import "github.com/faebut/prozessor_gostack/internal/models"
import "github.com/faebut/prozessor_gostack/view/layout"
import "github.com/faebut/prozessor_gostack/internal/helpers"
import "strconv"
import "time"
import "github.com/faebut/prozessor_gostack/view/ui"

templ Index(visitor models.Visitor) {
	{{
min := time.Now().AddDate(0, 0, -7).Format("2006-01-02")
max := time.Now().Format("2006-01-02")
	}}
	@layout.App(true, visitor) {
		<script src="https://go-echarts.github.io/go-echarts-assets/assets/echarts.min.js"></script>
		<div class="prose mb-6">
			<h1>Logs</h1>
		</div>
		@filterField()
		<div id="logsList" hx-get={ "/admin/logs/list?min=" + min + "&max=" + max + "&page=1&limit=25" } hx-trigger="load"></div>
	}
}

templ LogsList(logs []models.Log, onpage int, pages int, filter string) {
	<ul class="grid grid-cols-[min-content_min-content_1fr_min-content] my-6">
		for _, l := range logs {
			{{var levelColor string
switch l.Level {
case "ERROR":
	levelColor = "text-error"
case "INFO":
	levelColor = "text-info"
case "WARN":
	levelColor = "text-warning"
}
			}}
			<li class="grid grid-cols-subgrid col-span-4 border-dashed border-b border-base-content/50 py-5 my-0 gap-4">
				<div class="opacity-60 whitespace-nowrap col-span-2 md:col-span-1">
					{ l.CreatedOn.Format("2006-01-02 15:04:05") }
				</div>
				<div class={ "uppercase font-semibold opacity-60 col-span-2 md:col-span-1" + " " + levelColor }>[{ l.Level }]</div>
				<div class="col-span-full md:col-span-1">{ l.Message }</div>
				<div class="opacity-60 whitespace-nowrap">{ l.Visitor.FirstName } { l.Visitor.FamilyName }</div>
				<div class="md:col-span-2"></div>
				<div class="col-span-full md:col-span-2 text-xs opacity-60">{ l.Location }</div>
			</li>
		}
	</ul>
	@pagination(pages, onpage, filter)
}

templ filterField() {
	{{
minDate := time.Now().AddDate(0, 0, -7).Format("2006-01-02")
today := time.Now().Format("2006-01-02")
	}}
	<div class="border-base-content/20 border rounded-md dark:rounded-lg bg-base-100 my-4 p-4">
		<h2 class="font-bold text-xl mb-3">Suchfilter</h2>
		<form id="filterForm" novalidate>
			<div class="grid grid-cols-4 gap-5 items-start">
				@ui.CSRF()
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Startdatum</legend>
					<input
						type="date"
						id="min_date"
						name="min_date"
						class="input"
						value={ minDate }
						min="2025-01-01"
						max={ today }
					/>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Enddatum</legend>
					<input type="date" id="max_date" name="max_date" class="input" value={ today } min="2025-01-01" max={ today }/>
				</fieldset>
				<fieldset class="fieldset">
					<legend class="fieldset-legend">Resultate/Seite</legend>
					<select class="select" name="limit">
						<option>25</option>
						<option>50</option>
						<option>100</option>
					</select>
				</fieldset>
				<div class="col-span-4 grid grid-cols-2 justify-items-center gap-3">
					<button
						type="submit"
						hx-post="/admin/logs/filter"
						hx-target="#logsList"
						hx-swap="innerHTML"
						class="btn btn-success btn-outline"
					><span class="i-mdi-funnel"></span> filtern</button>
					<a href="/admin/logs" class="btn btn-error btn-outline">
						<span class="i-mdi-close"></span> zurücksetzen
					</a>
				</div>
			</div>
		</form>
	</div>
}

templ pagination(pages int, onpage int, filter string) {
	{{ pagesslice := helpers.Iterate(pages) }}
	<div class="grid justify-items-center">
		<div class="join pt-6">
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==1) }
				hx-target="#logsList"
				hx-get={ "/admin/logs/list?page=" + strconv.Itoa(onpage-1) + filter }
			>«</button>
			for _, p := range pagesslice {
				switch p {
					case 1, pages, onpage, onpage+1, onpage-1:
						<button
							class={ "join-item btn" , templ.KV("btn-primary", onpage==p) }
							hx-target="#logsList"
							hx-get={ "/admin/logs/list?page=" + strconv.Itoa(p) + filter }
						>{ strconv.Itoa(p) }</button>
					case onpage+2, onpage-2:
						<button class="join-item btn btn-disabled">.</button>
				}
			}
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==pages) }
				hx-target="#logsList"
				hx-get={ "/admin/logs/list?page=" + strconv.Itoa(onpage+1) + filter }
			>»</button>
		</div>
	</div>
}
