package logs

import "github.com/faebut/prozessor_gostack/internal/models"
import "github.com/faebut/prozessor_gostack/view/layout"
import "github.com/faebut/prozessor_gostack/internal/helpers"
import "strconv"

templ Index(visitor models.Visitor) {
	@layout.App(true, visitor) {
		<script src="https://go-echarts.github.io/go-echarts-assets/assets/echarts.min.js"></script>
		<div class="prose mb-6">
			<h1>Logs</h1>
		</div>
		<div id="logsList" hx-get="/admin/logs/list?page=1&limit=25" hx-trigger="load"></div>
	}
}

templ LogsList(logs []models.Log, onpage int, pages int) {
	<ul class="grid grid-cols-[min-content_min-content_1fr_min-content] bg-base-100 rounded-box shadow-md">
		for _, l := range logs {
			{{var levelColor string
switch l.Level {
case "ERROR":
	levelColor = "text-error"
case "INFO":
	levelColor = "text-info"
case "WARN":
	levelColor = "text-warning"
}
			}}
			<li class="grid grid-cols-subgrid col-span-4 border-dashed border-b border-base-content/50 py-3 my-0 gap-4 mb-6">
				<div class="opacity-60 whitespace-nowrap col-span-2 md:col-span-1">
					{ l.CreatedOn.Format("2006-01-02 15:04:05") }
				</div>
				<div class={ "uppercase font-semibold opacity-60 col-span-2 md:col-span-1" + " " + levelColor }>[{ l.Level }]</div>
				<div class="col-span-full md:col-span-1">{ l.Message }</div>
				<div class="opacity-60 whitespace-nowrap">{ l.Visitor.FirstName } { l.Visitor.FamilyName }</div>
				<div class="md:col-span-2"></div>
				<div class="col-span-full md:col-span-2 text-xs opacity-60">{ l.Location }</div>
			</li>
		}
	</ul>
	@pagination(pages, onpage)
}

templ pagination(pages int, onpage int) {
	{{ pagesslice := helpers.Iterate(pages) }}
	<div class="grid justify-items-center">
		<div class="join pt-6">
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==1) }
				hx-target="#logsList"
				hx-get={ "/admin/logs/list?page=" + strconv.Itoa(onpage-1) + "&limit=25" }
			>«</button>
			for _, p := range pagesslice {
				switch p {
					case 1, pages, onpage, onpage+1, onpage-1:
						<button
							class={ "join-item btn" , templ.KV("btn-primary", onpage==p) }
							hx-target="#logsList"
							hx-get={ "/admin/logs/list?page=" + strconv.Itoa(p) + "&limit=25" }
						>{ strconv.Itoa(p) }</button>
					case onpage+2, onpage-2:
						<button class="join-item btn btn-disabled">.</button>
				}
			}
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==pages) }
				hx-target="#logsList"
				hx-get={ "/admin/logs/list?page=" + strconv.Itoa(onpage+1) + "&limit=25" }
			>»</button>
		</div>
	</div>
}
