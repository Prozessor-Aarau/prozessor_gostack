package profile

import (
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/internal/render"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
	"strconv"
)

type ProfileErrors struct {
	FirstName     string
	FamilyName    string
	Birthdate     string
	Phone         string
	Email         string
	Address       string
	Postcode      string
	City          string
	Password      string
	PasswordCheck string
	Avatar        string
	AppError      string
}

templ Profile(
	visitor models.Visitor,
	profile models.Visitor,
	roles []models.Role,
	ressorts []models.Ressort,
	route string,
	referer string) {
	@layout.App(true, visitor) {
		<div class="prose mb-10">
			<h1>Profil von { profile.FirstName } { profile.FamilyName }</h1>
			<h2 class="mt-0">Stammdaten</h2>
		</div>
		@ProfileForm(visitor, profile, ProfileErrors{}, roles, ressorts, route, referer)
	}
}

// check where the route is coming from to set post route
func checkRoute(route string, id string) string {
	base := "/admin/"
	if route == "profile" {
		return base + "profile"
	}
	return base + "visitors/" + id
}

templ ProfileForm(
	visitor models.Visitor,
	profile models.Visitor,
	errors ProfileErrors,
	roles []models.Role,
	ressorts []models.Ressort,
	route string,
	referer string) {
	{{ prm := ctx.Value("permission").(models.Role) }}
	<form
		id="profileForm"
		class="grid grid-cols-4 gap-1 sm:gap-3 overflow-y-auto p-1"
		hx-post={ checkRoute(route,
  profile.ID) }
		hx-target="#profileForm"
		hx-swap="outerHTML"
		enctype="multipart/form-data"
		novalidate
	>
		@ui.CSRF()
		<input type="hidden" name="ref" value={ referer }/>
		<input type="hidden" name="route" value={ route }/>
		<fieldset class="fieldset col-span-4 md:col-span-2">
			<legend class="fieldset-legend">Vorname <span class="text-error font-extrabold">*</span></legend>
			<input
				type="text"
				id="first_name"
				name="first_name"
				class={ "input w-full" , templ.KV("input-error",
      len(errors.FirstName)> 0) }
				value={ profile.FirstName }
				required
			/>
			if len(errors.FirstName) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.FirstName }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-4 md:col-span-2">
			<legend class="fieldset-legend">Familienname <span class="text-error font-extrabold">*</span></legend>
			<input
				type="text"
				id="family_name"
				name="family_name"
				class={ "input w-full" , templ.KV("input-error",
      len(errors.FamilyName)> 0) }
				value={ profile.FamilyName }
				required
			/>
			if len(errors.FamilyName) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.FamilyName }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-4 sm:col-span-2 md:col-span-1">
			<legend class="fieldset-legend">Geburtsdatum <span class="text-error font-extrabold">*</span></legend>
			<input
				type="date"
				id="birthdate"
				name="birthdate"
				class={ "input w-full" , templ.KV("input-error",
      len(errors.Birthdate)>
    0) }
				if render.RealDate(profile.Birthdate) {
					value={ render.HumanDate(profile.Birthdate) }
				}
				required
			/>
			if len(errors.Birthdate) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.Birthdate }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-4 sm:col-span-2 md:col-span-1">
			<legend class="fieldset-legend">Telefonnummer <span class="text-error font-extrabold">**</span></legend>
			<input
				type="text"
				id="phone"
				name="phone"
				class={ "input w-full" , templ.KV("input-error", len(errors.Phone)> 0) }
				value={ profile.Phone }
			/>
			if len(errors.Phone) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.Phone }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-4 md:col-span-2">
			<legend class="fieldset-legend">E-Mail <span class="text-error font-extrabold">**</span></legend>
			<input
				type="text"
				id="email"
				name="email"
				class={ "input w-full" , templ.KV("input-error", len(errors.Email)> 0) }
				value={ profile.Email }
			/>
			if len(errors.Email) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.Email }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-4 md:col-span-2">
			<legend class="fieldset-legend">Strasse Nr. <span class="text-error font-extrabold">*</span></legend>
			<input
				type="text"
				id="address"
				name="address"
				class={ "input w-full" , templ.KV("input-error", len(errors.Address)>
    0) }
				value={ profile.Address }
				required
			/>
			if len(errors.Address) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.Address }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">PLZ <span class="text-error font-extrabold">*</span></legend>
			<input
				type="text"
				id="postcode"
				name="postcode"
				class={ "input w-full" , templ.KV("input-error",
      len(errors.Postcode)> 0) }
				value={ profile.Postcode }
				required
			/>
			if len(errors.Postcode) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.Postcode }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-3 md:col-span-1">
			<legend class="fieldset-legend">Ort <span class="text-error font-extrabold">*</span></legend>
			<input
				type=" text"
				name="city"
				id="city"
				class={ "input w-full" , templ.KV("input-error", len(errors.City)>
    0) }
				value={ profile.City }
				required
			/>
			if len(errors.City) > 0 {
				<p class="fieldset-label text-error mt-0 mb-0">
					{ errors.City }
				</p>
			}
		</fieldset>
		<fieldset class="fieldset col-span-full">
			<legend class="fieldset-legend">Informationen</legend>
			<textarea
				id="infos"
				name="infos"
				class="textarea h-24 w-full"
				placeholder="Allergien, Besonderes..."
				value={ profile.Infos }
			></textarea>
		</fieldset>
		<fieldset class="fieldset p-4 bg-base-100 border border-base-content/20 rounded-box col-span-full">
			<!-- <legend class="fieldset-legend">Newsletter</legend> -->
			<label class="fieldset-label gap-4">
				<input type="checkbox" name="newsletter" class="checkbox" checked?={ profile.Newsletter }/>
				Prozessor Newsletter erhalten.
			</label>
		</fieldset>
		<div class="col-span-4 text-sm">
			<span class="text-error font-extrabold">*</span> diese Felder sind zwingend
			auszufüllen
		</div>
		<div class="col-span-4 text-sm">
			<span class="text-error font-extrabold">**</span> mindestens eine Angabe nötig
			(entweder/oder)
		</div>
		<!-- Vereinsmitgliedschaft -->
		if prm.EditVisitorMembership || prm.EditVisitorRole {
			<div class="pt-6 col-span-full prose">
				<h2>Vereinsmitgliedschaft</h2>
			</div>
		}
		if prm.EditVisitorMembership {
			<fieldset class="fieldset col-span-4 md:col-span-2">
				<legend class="fieldset-legend">Ressort für Mitgliedschaft auswählen</legend>
				<select id="ressort" name="ressort" class="select w-full">
					<option selected value="0">kein Ressort</option>
					for _,r := range ressorts {
						<option value={ strconv.Itoa(r.ID) } selected?={ r.ID==profile.Ressort.ID }>{ r.RessortName }</option>
					}
				</select>
			</fieldset>
		}
		if prm.EditVisitorRole {
			<fieldset class="fieldset col-span-4 md:col-span-2">
				<legend class="fieldset-legend">
					Zugangs-Level auswählen
				</legend>
				<select id="role" name="role" class="select w-full ">
					<option selected value="0">keine Rolle</option>
					for _, r := range roles {
						<option value={ strconv.Itoa(r.ID) } selected?={ profile.RoleID==r.ID }>{ r.RoleName }</option>
					}
				</select>
			</fieldset>
		}
		if prm.EditVisitorMembership {
			<div class="col-span-full flex items-center justify-start gap-3">
				<a class="btn btn-secondary" hx-post="/admin/createloginmail" hx-target="#loginresponse">
					Registrations-Mail
					versenden
				</a>
				<div id="loginresponse" class="label font-extrabold text-success"></div>
			</div>
		}
		<!-- Profile specific fields -->
		if route == "profile" {
			<div class="pt-6 col-span-full prose">
				<h2>Nutzerprofil</h2>
			</div>
			<fieldset class="fieldset col-span-4 md:col-span-2">
				<legend class="fieldset-legend">Passwort ändern</legend>
				<input
					type="password"
					name="password"
					id="password"
					class={ "input w-full" , templ.KV("input-error",
      len(errors.Password)>
    0) }
				/>
				if len(errors.Password) > 0 {
					<p class="fieldset-label text-error mt-0 mb-0">
						{ errors.Password }
					</p>
				}
			</fieldset>
			<fieldset class="fieldset col-span-4 md:col-span-2">
				<legend class="fieldset-legend">neues Passwort wiederholen</legend>
				<input
					type="password"
					name="password_check"
					id="password_check"
					class={ "input w-full" , templ.KV("input-error",
      len(errors.PasswordCheck)>0) }
				/>
				if len(errors.PasswordCheck) > 0 {
					<p class="fieldset-label text-error mt-0 mb-0">
						{ errors.PasswordCheck }
					</p>
				}
			</fieldset>
			<!-- Avatar -->
			if len(profile.Avatar) > 0 {
				<div class="avatar col-span-1">
					<div class="w-24 rounded-full">
						<img src={ "/static/uploads/" + profile.Avatar } class="mt-0"/>
					</div>
				</div>
			}
			<fieldset class={ "fieldset col-span-4" , templ.KV("col-span-3", len(profile.Avatar)> 0) }>
				<legend class="fieldset-legend">
					if len(profile.Avatar) > 0 {
						Avatar ersetzen
					} else {
						Avatar hochladen
					}
				</legend>
				<input type="file" name="avatar" id="avatarInput" class="file-input w-full"/>
				if len(errors.Avatar) > 0 {
					<p class="fieldset-label text-error mt-0 mb-0">
						{ errors.Avatar }
					</p>
				}
			</fieldset>
			if len(profile.Avatar)> 0 {
				<fieldset class="fieldset p-4 bg-base-100 border border-base-content/20 rounded-box w-full col-span-full gap-4">
					<label class="fieldset-label">
						<input
							type="checkbox"
							name="delete_avatar"
							id="delete_avatar"
							onchange="inactive()"
							class="toggle toggle-error"
						/>
						Avatar löschen
					</label>
				</fieldset>
			}
		}
		if len(errors.AppError)>0 {
			<div class="col-span-full my-10">
				@layout.Error(errors.AppError)
			</div>
		}
		<div class="col-span-full flex items-center gap-3 justify-center">
			<input type="submit" class="btn btn-success col-span-2 mt-3" value="Speichern"/>
			<a onclick="history.back()" class="btn btn-warning col-span-2 mt-3">
				<span class="i-mdi-cancel-bold"></span>
				Abbrechen
			</a>
		</div>
	</form>
	<script>
  fileBox = document.querySelector("#avatarInput")
  toggle = document.querySelector("#delete_avatar")
  fileText = document.querySelector("#avatartext")

  if (toggle !== null) {
    toggle.onchange = function () {
      fileBox.toggleAttribute("disabled")
      fileText.classList.toggle("opacity-40")
    }
  }
</script>
}
