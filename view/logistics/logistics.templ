package logistics

import (
	"github.com/faebut/prozessor_gostack/internal/helpers"
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
	"strconv"
	"time"
)

templ Logistics(visitor models.Visitor, categories []models.LogisticCategory) {
	@layout.App(true, visitor) {
		<div class="prose mb-10">
			<h1>Lagerverwaltung</h1>
		</div>
		<div id="content">
			@logisticsFilter(categories)
			<div id="logisticsList" hx-get="/admin/logistics/list" hx-trigger="load"></div>
		</div>
	}
}

templ logisticsFilter(categories []models.LogisticCategory) {
	{{ prm := ctx.Value("permission").(models.Role) }}
	<div class="border-base-content/20 border rounded-md dark:rounded-lg bg-base-100 my-4 p-4">
		<h2 class="font-bold text-xl mb-3">Suchfilter</h2>
		<form id="filterForm" novalidate>
			<div class="grid grid-cols-4 gap-5 items-center">
				@ui.CSRF()
				<label class="input flex items-center gap-2 col-span-full">
					<span class="text-3xl i-mdi-magnify"></span>
					<input
						type="text"
						id="filter_string"
						name="filter_string"
						class="grow"
						placeholder="Suche nach Lagerplatz, Vorname, Familienname ..."
					/>
					<!-- how to implement this button? should reset field -->
					<button id="fieldreset" class="ml-3 btn btn-neutral btn-outline btn-xs btn-circle">
						<span class="i-mdi-close"></span>
					</button>
				</label>
				<label class="form-control w-full max-w-xs col-span-full md:col-span-1">
					<select name="inuse" id="inuse" class="select select-bordered">
						<option value="all">Verfügbarkeit (alle)</option>
						<option value="used">vergeben</option>
						<option value="available">verfügbar</option>
					</select>
				</label>
				<label class="form-control w-full max-w-xs col-span-full md:col-span-1">
					<select name="validity" id="validity" class="select select-bordered">
						<option value="all">Gültigkeit (alle)</option>
						<option value="valid">Noch gültig</option>
						<option value="invalid">bereits abgelaufen</option>
					</select>
				</label>
				<label class="form-control w-full max-w-xs col-span-full md:col-span-1">
					<select name="type" id="type" class="select select-bordered">
						<option value="0" selected>Typ (alle)</option>
						for _, v := range categories {
							<option value={ strconv.Itoa(v.ID) }>{ v.CatName }</option>
						}
					</select>
				</label>
				<div class="col-span-full md:col-span-1 grid grid-cols-2 justify-items-center justify-around gap-3">
					<button
						type="submit"
						hx-post="/admin/logistics/list"
						hx-target="#logisticsList"
						class="btn btn-success btn-outline btn-circle"
					><span class="i-mdi-magnify text-xl"></span></button>
					<a href="/admin/logistics" class="btn btn-error btn-outline btn-circle">
						<span class="i-mdi-close text-xl"></span>
					</a>
				</div>
			</div>
		</form>
		if prm.EditLogistics {
			<div class="border-base-content/50 border-dashed border-t mt-4 pt-4 flex flex-col md:flex-row gap-3">
				<button type="button" class="btn btn-secondary" hx-get="/admin/logistics/create" hx-target="#content">
					Lagerplatz
					hinzufügen
				</button>
				<button type="button" class="btn btn-primary" hx-get="/admin/logistics/billing" hx-target="#content">
					Lagerplätze
					verrechnen
				</button>
			</div>
		}
	</div>
	<!-- For the switches -->
	<script>
		searchField = document.querySelector("#filter_string");

		document
			.getElementById("fieldreset")
			.addEventListener("click", function (event) {
				event.preventDefault();
				searchField.value = "";
			});
	</script>
}

templ LogisticsList(logistics []models.Logistic, pages int, onpage int, filter string) {
	{{ prm := ctx.Value("permission").(models.Role) }}
	if len(logistics) > 0 {
		for _, l := range logistics {
			{{
				var contact string
				if len(l.Visitor.Phone) > 0 {
					contact = l.Visitor.Phone
				} else if len(l.Visitor.Email) > 0 {
					contact = l.Visitor.Email
				}
			}}
			<div
				class="hover:bg-base-200 cursor-pointer grid grid-cols-9 text-sm p-3 py-4 items-center gap-3 border-dashed border-b border-base-content/50"
			>
				<div class="col-span-1">{ strconv.Itoa(l.Number) }</div>
				<div class="col-span-1 text-2xl flex items-center">
					if len(l.Visitor.ID) > 0 {
						if l.EndDate.Sub(time.Now()).Hours() / 24 > 0 {
							<span class="i-mdi-check-circle text-success"></span>
						} else {
							<span class="i-mdi-check-circle text-error"></span>
						}
					} else {
						<span class="i-mdi-close-circle-outline"></span>
					}
				</div>
				<div class="col-span-6 md:col-span-1">{ l.Category.CatName }</div>
				<div class="col-span-5 md:col-span-2 text-right md:text-left">
					{ l.Visitor.FirstName }
					{ l.Visitor.FamilyName }
				</div>
				<div class="col-span-4 md:col-span-2 text-right md:text-left">
					{ contact }
				</div>
				<div class="col-span-full md:col-span-1 flex justify-end gap-3 items-center md:text-left">
					if l.BillID > 0 {
						if l.BillPaid {
							<span class="text-success">
								{ strconv.FormatFloat(l.Price, 'f', 2, 64) }
							</span>
							<span class="i-mdi-cash-check text-success text-lg"></span>
						} else {
							<span class="text-warning">
								{ strconv.FormatFloat(l.Price, 'f', 2, 64) }
							</span>
							<span class="i-mdi-cash-clock text-warning text-lg"></span>
						}
					} else if l.Price > 0 {
						<span class="text-error">
							{ strconv.FormatFloat(l.Price, 'f', 2, 64) }
						</span>
						<span class="i-mdi-cash-remove text-error text-lg"></span>
					}
				</div>
				<div class="col-span-full md:col-span-1 flex justify-center md:justify-end items-center">
					<a
						class={ "btn btn-sm btn-circle btn-primary" , templ.KV("btn-disabled", !prm.EditLogistics) }
						hx-get={ "/admin/logistics/" + strconv.Itoa(l.ID) }
						hx-target="#content"
					>
						<span class="i-mdi-lead-pencil"></span>
					</a>
				</div>
			</div>
		}
		@pagination(pages, onpage, filter)
	} else {
		<div class="my-10">
			@layout.Warning("keine Suchergebnisse")
		</div>
	}
}

templ pagination(pages int, onpage int, filter string) {
	{{ pagesslice := helpers.Iterate(pages) }}
	<div class="grid justify-items-center">
		<div class="join pt-6">
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==1) }
				hx-target="#logisticsList"
				hx-get={ "/admin/logistics/list?page=" + strconv.Itoa(onpage-1) + filter }
			>«</button>
			for _, p := range pagesslice {
				switch p {
					case 1, pages, onpage, onpage+1, onpage-1:
						<button
							class={ "join-item btn" , templ.KV("btn-primary", onpage==p) }
							hx-target="#logisticsList"
							hx-get={ "/admin/logistics/list?page=" + strconv.Itoa(p) + filter }
						>{ strconv.Itoa(p) }</button>
					case onpage+2, onpage-2:
						<button class="join-item btn btn-disabled">.</button>
				}
			}
			<button
				class={ "join-item btn" , templ.KV("btn-disabled", onpage==pages) }
				hx-target="#logisticsList"
				hx-get={ "/admin/logistics/list?page=" + strconv.Itoa(onpage+1) + filter }
			>»</button>
		</div>
	</div>
}

type FormErrors struct {
	Number    string
	UnitPrice string
	StartDate string
	EndDate   string
	Category  string
	Visitor   string
	AppError  string
}

templ LogisticsForm(
	l models.Logistic,
	categories []models.LogisticCategory,
	errors FormErrors,
	assigned bool,
) {
	{{
		var postUrl string
		if l.CreatedOn.IsZero() {
			postUrl = "/admin/logistics/create"
		} else {
			postUrl = "/admin/logistics/" + strconv.Itoa(l.ID)
		}

		var fixCat []models.LogisticCategory
		var freeCat []models.LogisticCategory

		for _, cat := range categories {
			if cat.ID < 4 {
				fixCat = append(fixCat, cat)
			} else {
				freeCat = append(freeCat, cat)
			}
		}
	}}
	<form
		class="grid grid-cols-2 items-center gap-3 "
		id="postForm"
		novalidate
	>
		<input type="hidden" name="id" value={ strconv.Itoa(l.ID) }/>
		@ui.CSRF()
		<div class="prose col-span-full">
			if l.CreatedOn.IsZero() {
				<h2>Lagerplatz erstellen</h2>
			} else {
				<h2>Lagerplatz bearbeiten</h2>
			}
		</div>
		if len(l.Visitor.ID) > 0 {
			@Label(l)
		}
		<!-- toggle fix place or free place, only in creation mode  -->
		<fieldset class="fieldset col-span-full gap-5">
			<label class="fieldset-label">
				<input id="toggleFree" name="free" type="checkbox" class="toggle toggle-success" checked?={ l.Category.ID>= 4 }/>
				Sperrgut/Kleingut ohne fixen Palettenplatz
			</label>
		</fieldset>
		<!-- form for fixed places -->
		<div id="fixForm" class={ "col-span-full grid grid-cols-4 gap-3" , templ.KV("hidden",l.Category.ID>= 4 ) }>
			<div class="prose col-span-full">
				<h3>Fixer Palettenplatz</h3>
			</div>
			<fieldset class="fieldset w-full col-span-2 md:col-span-1">
				<legend class="fieldset-legend">Nummer</legend>
				<input
					class={ "input w-full" , templ.KV("input-error", len(errors.Number)>0) }
					name="number"
					type="text"
					placeholder="Nummer"
					value={ strconv.Itoa(l.Number) }
				/>
				if len(errors.Number)>0 {
					<label class="fieldset-label text-error">{ errors.Number }</label>
				}
			</fieldset>
			<fieldset class="fieldset w-full col-span-2 md:col-span-1">
				<legend class="fieldset-legend">Preis/Monat</legend>
				<span id="fix_price" class="pl-1 py-1 text-lg text-primary font-bold "></span>
			</fieldset>
			<fieldset class="fieldset col-span-full md:col-span-2">
				<legend class="fieldset-legend">Palettengrösse</legend>
				<select id="fixCatSelect" name="fix_cat" class="select select-bordered w-full">
					for _,c := range fixCat {
						<option value={ strconv.Itoa(c.ID) } selected?={ c.ID==l.Category.ID }>{ c.CatName }</option>
					}
				</select>
			</fieldset>
		</div>
		<!-- form for free places -->
		<div id="freeForm" class={ "col-span-full grid grid-cols-4 gap-3" , templ.KV("hidden", l.Number < 200) }>
			<div class="prose col-span-full">
				<h3>Freier Palettenplatz</h3>
			</div>
			<fieldset class="fieldset w-full col-span-2 md:col-span-1">
				<legend class="fieldset-legend">Nummer</legend>
				<span id="freeNumber" class="pl-1 py-1 text-primary text-lg font-bold"></span>
			</fieldset>
			<fieldset class="fieldset w-full col-span-2 md:col-span-1">
				<legend class="fieldset-legend">Preis/Monat</legend>
				<input
					class={ "input w-full" , templ.KV("input-error", len(errors.UnitPrice)>0) }
					placeholder="0.00"
					name="free_price"
					id="free_price"
					type="text"
					value={ strconv.FormatFloat(l.UnitPrice, 'f', 2, 64) }
				/>
				if len(errors.UnitPrice)>0 {
					<label class="fieldset-label text-error">{ errors.UnitPrice }</label>
				}
			</fieldset>
			<fieldset class="fieldset col-span-full md:col-span-2">
				<legend class="fieldset-legend">Grösse</legend>
				<select id="freeCatSelect" name="free_cat" class="select select-bordered w-full">
					for _,c := range freeCat {
						<option value={ strconv.Itoa(c.ID) } selected?={ c.ID==l.Category.ID }>{ c.CatName }</option>
					}
				</select>
			</fieldset>
		</div>
		<!-- toggle for assigning or not -->
		<fieldset id="assignDiv" class={ "fieldset col-span-full gap-5" , templ.KV("hidden", l.Number>= 200) }>
			<label class="fieldset-label">
				<input
					checked?={ len(l.Visitor.ID)> 0 || assigned }
					id="toggleAssign"
					name="assign"
					type="checkbox"
					class="toggle toggle-success"
				/>
				Platz zuweisen
			</label>
		</fieldset>
		<!-- form for all places -->
		<div id="assignForm" class={ "col-span-full grid grid-cols-2 gap-3" , templ.KV("hidden", !assigned) }>
			<div class="prose col-span-full">
				<h3>Zuweisung</h3>
			</div>
			<fieldset class="fieldset col-span-full md:col-span-1">
				<legend class="fieldset-legend">Startdatum</legend>
				<input
					type="date"
					id="startdate"
					name="startdate"
					class={ "input w-full" , templ.KV("input-error",
        len(errors.StartDate)> 0) }
					if !l.StartDate.IsZero() {
						value={ l.StartDate.Format("2006-01-02") }
					}
					required
				/>
				if len(errors.StartDate) > 0 {
					<label class="fieldset-label text-error">{ errors.StartDate }</label>
				}
			</fieldset>
			<fieldset class="fieldset col-span-full md:col-span-1">
				<legend class="fieldset-legend">Enddatum</legend>
				<input
					type="date"
					id="enddate"
					name="enddate"
					class={ "input w-full" , templ.KV("input-error",
        len(errors.EndDate)> 0) }
					if !l.EndDate.IsZero() {
						value={ l.EndDate.Format("2006-01-02") }
					}
					required
				/>
				if len(errors.EndDate) > 0 {
					<label class="fieldset-label text-error">{ errors.EndDate }</label>
				}
			</fieldset>
			<div class="label mb-0 pb-0 col-span-full">
				<span class="fieldset-legend text-xs mb-0 pb-0">Mitglied zuweisen</span>
			</div>
			<form id="filterForm" class="mb-3 w-full col-span-2 md:col-span-1" novalidate>
				@ui.CSRF()
				<label class="input flex items-center gap-2 w-full">
					<span class="text-3xl i-mdi-magnify"></span>
					<input
						hx-post={ "/admin/visitors/selectbox/" + l.Visitor.ID + "?member" }
						hx-trigger="input changed delay:500ms, search"
						hx-target="#memberSelect"
						placeholder="Suche nach Name, Vorname oder Ort..."
						type="search"
						id="search_term"
						name="search_term"
						class="grow w-full"
					/>
				</label>
			</form>
			<div
				hx-get={ "/admin/visitors/selectbox/" + l.Visitor.ID + "?member" }
				hx-trigger="load"
				id="memberSelect"
				class="mb-3 col-span-2 md:col-span-1"
			></div>
			if len(errors.Visitor) > 0 {
				<div class="my-4 col-span-full">
					@layout.Error(errors.Visitor)
				</div>
			}
			<div class="col-span-full md:col-span-1 prose">
				<h3>Preis Total</h3>
				<div class="content-center">
					<span id="result_price" class=" text-secondary text-xl font-bold"></span>
				</div>
				<input type="hidden" id="membership" name="membership" value={ strconv.FormatBool(l.Member) }/>
			</div>
		</div>
		<!-- error handling for app and post buttons -->
		if len(errors.AppError)>0 {
			<div class="my-4">
				@layout.Error(errors.AppError)
			</div>
		}
		<div class="col-span-full w-full gap-3 flex mt-3 items-center justify-center flex-col md:flex-row">
			if l.BillID == 0 {
				<a hx-post={ postUrl } class="btn btn-success" hx-target="#content">
					Speichern
				</a>
			} else {
				<div class="btn btn-success" onclick="my_modal_5.showModal()">Speichern</div>
				<dialog id="my_modal_5" class="modal modal-bottom sm:modal-middle">
					<div class="modal-box">
						<h3 class="text-xl font-bold">Achtung!</h3>
						<p class="py-4 font-bold">
							Für diesen Lagerplatz ist bereits eine Rechnung für { l.Visitor.FirstName } { l.Visitor.FamilyName } erfasst.
						</p>
						<p class="py-4">Zeitraum: { l.StartDate.Format("02.01.2006") } bis { l.EndDate.Format("02.01.2006") }</p>
						<p class="py-4">
							Zahlstatus:
							if l.BillPaid {
								<span class="text-success">bezahlt</span>
							} else {
								<span class="text-warning">unbezahlt</span>
							}
						</p>
						<p
							x-show="!$store.updateState.laterDate && !$store.updateState.newMember && $store.updateState.assigned"
							class="py-4"
						>
							Um den Zeitraum zu verlängern, bitte das neue Startdatum auf das alte Enddatum ({ 
          l.EndDate.Format("02.01.2006") }) oder später ändern.
						</p>
						if !l.BillPaid {
							<p
								x-show="!$store.updateState.laterDate && !$store.updateState.newMember && $store.updateState.assigned"
								class="py-4"
							>
								Für diesen Lagerplatz ist für diesen Benutzer eine offene Rechnung vorhanden. Wenn für den gesamten Zeitraum
								eine neue Rechnung erstellt werden soll, muss die alte zuerst von der Buchhaltung aus dem System gelöscht
								werden. Danach kann der Lagerplatz für den neuen Zeitraum zugewiesen und verrechnet werden.
							</p>
						}
						<p x-show="$store.updateState.newMember && $store.updateState.assigned" class="py-4">
							Der Lagerplatz wird einem neuen Benutzer zugewiesen. Die alte Rechnung ist davon nicht betroffen.
						</p>
						<p x-show="!$store.updateState.assigned" class="py-4 italic text-error text-sm">
							Beim Speichervorgang wird die Zuweisung des Lagerplatzes gelöscht. Die bestehende Rechnung ist davon nicht
							betroffen. Falls diese gelöscht werden soll, bitte der Buchhaltung melden.
						</p>
						<p x-show="$store.updateState.assigned" class="py-4 italic text-error text-sm">
							Beim Speichervorgang wird die Zuweisung der alten Rechnung zu diesem Lagerplatz gelöscht. Die Rechnung bleibt
							aber im
							System aktiv. Falls diese gelöscht werden soll, bitte der Buchhaltung melden.
						</p>
						<div class="modal-action">
							<form method="dialog">
								<!-- if there is a button in form, it will close the modal -->
								<a
									id="updateButton"
									hx-post={ postUrl }
									hx-include="#postForm"
									class="btn btn-success"
									hx-target="#content"
									x-bind:disabled="!$store.updateState.laterDate && !$store.updateState.newMember && $store.updateState.assigned"
								>
									speichern
								</a>
								<button class="btn btn-warning">schliessen</button>
							</form>
						</div>
					</div>
				</dialog>
			}
			<a href="/admin/logistics" class="btn btn-warning">
				<span class="i-mdi-cancel-bold"></span>
				Abbrechen
			</a>
			if !l.CreatedOn.IsZero() {
				<a
					if l.Number>=200 {
						hx-confirm="Lagerplatz wirklich löschen?"
					} else {
						hx-confirm="Lagerplatz wirklich löschen? Zuweisungen kannst du durch editieren löschen"
					}
					id="deleteButton"
					class="btn btn-error btn-circle"
					hx-delete={ "/admin/logistics/" + strconv.Itoa(l.ID) }
				>
					<span class="i-mdi-trash text-2xl"></span>
				</a>
			}
		</div>
		// pass data to javascript
		@templ.JSONScript("categories", fixCat)
		@templ.JSONScript("logistics", l)
	</form>
	<!-- script for ui changes -->
	<script>
		var toggle = document.getElementById("toggleFree");
		var assign = document.getElementById("toggleAssign");
		var assignDiv = document.getElementById("assignDiv");
		var assignForm = document.getElementById("assignForm");
		var freeForm = document.getElementById("freeForm");
		var fixForm = document.getElementById("fixForm");
		var fixCatSelect = document.getElementById("fixCatSelect");
		var fixPrice = document.getElementById("fix_price");
		var freeCatSelect = document.getElementById("freeCatSelect");
		var freePrice = document.getElementById("free_price");
		var freeNumber = document.getElementById("freeNumber");
		var startDate = document.getElementById("startdate");
		var endDate = document.getElementById("enddate");
		var resultPrice = document.getElementById("result_price");
		var updateButton = document.getElementById("updateButton");
		var categories = JSON.parse(
			document.getElementById("categories").textContent,
		);
		var logistics = JSON.parse(
			document.getElementById("logistics").textContent,
		);

		// init alpine store
		Alpine.store("updateState", {
			newMember: false,
			laterDate: false,
			assigned: false,
		});

		// initialize
		selectChange();
		setNumber();
		calcPrice();
		assignChecker();

		function assignChecker() {
			if (assign.checked) {
				Alpine.store("updateState").assigned = true;
				assignForm.classList.remove("hidden");
			} else {
				Alpine.store("updateState").assigned = false;
				assignForm.classList.add("hidden");
			}

			console.log("assigned", Alpine.store("updateState").assigned);
		}

		assign.onchange = () => {
			assignChecker();
		};

		// toggle behaviour on changing category
		function selectChange() {
			var membership = document.getElementById("membership");
			var id = fixCatSelect.value;

			var price = 0;

			// need to check for member here
			if (membership.value == "true") {
				price = categories.find((x) => x.ID == id).PriceMember;
			} else {
				price = categories.find((x) => x.ID == id).Price;
			}

			fixPrice.innerText = price;

			let memberSelect = document.getElementById("member");

			// check if the member has changed
			if (memberSelect !== null) {
				if (logistics.Visitor.ID == memberSelect.value) {
					Alpine.store("updateState").newMember = false;
				} else {
					Alpine.store("updateState").newMember = true;
				}
			}

			console.log("newMember:", Alpine.store("updateState").newMember);
		}

		function calcPrice() {
			let price = 0;
			let start = new Date(startDate.value);
			let end = new Date(endDate.value);
			var timeDiff = Math.abs(end.getTime() - start.getTime());
			var Daydiff = Math.ceil(timeDiff / (1000 * 3600 * 24));

			// get factor of time from days
			var timeFactor = 0;
			var timeDiff = Math.abs(end.getTime() - start.getTime());
			var Daydiff = Math.ceil(timeDiff / (1000 * 3600 * 24));
			var Mondiff = Daydiff / 30;

			if (Mondiff <= 0.5) {
				timeFactor = 0.5;
			} else {
				timeFactor = Math.round(Mondiff);
			}

			var basePrice = 0;

			if (toggle.checked) {
				basePrice = freePrice.value;
			} else {
				basePrice = fixPrice.innerText;
			}

			price = basePrice * timeFactor;
			if (isNaN(price)) {
				resultPrice.innerHTML = "Bitte Start- und Enddatum setzen";
			} else {
				resultPrice.innerHTML = price;
			}
		}

		function setNumber() {
			if (freeCatSelect.value == 4) {
				freeNumber.innerText = "200";
			} else {
				freeNumber.innerText = "300";
			}
		}

		// handle change events
		fixCatSelect.addEventListener("change", () => {
			selectChange();
			calcPrice();
		});

		startDate.addEventListener("change", () => {
			calcPrice();
			checkUpdateable();
		});

		endDate.addEventListener("change", () => {
			calcPrice();
			checkUpdateable();
		});

		freePrice.addEventListener("change", () => {
			calcPrice();
		});

		if (toggle !== null) {
			toggle.onchange = function () {
				freeForm.classList.toggle("hidden");
				fixForm.classList.toggle("hidden");
				calcPrice();

				if (toggle.checked) {
					assignDiv.classList.add("hidden");
					assignForm.classList.remove("hidden");
				} else {
					assignDiv.classList.remove("hidden");
					if (assign.checked) {
						Alpine.store("updateState").assigned = true;
						assignForm.classList.remove("hidden");
					} else {
						Alpine.store("updateState").assigned = false;
						assignForm.classList.add("hidden");
					}
				}
			};
		}

		freeCatSelect.addEventListener("change", () => {
			setNumber();
		});

		// for updating check if everything is okay and change content of modal
		function checkUpdateable() {
			let newStartDate = new Date(startDate.value);
			let newEndDate = new Date(endDate.value);
			let oldStartDate = new Date(logistics.StartDate);
			let oldEndDate = new Date(logistics.EndDate);

			// check if new start date is after old end date
			if (newStartDate < oldEndDate) {
				Alpine.store("updateState").laterDate = false;
			} else {
				Alpine.store("updateState").laterDate = true;
			}
			console.log("laterDate:", Alpine.store("updateState").laterDate);
		}

		checkUpdateable();
	</script>
	<!-- this script is needed for the delete button to send the CSRF-Token -->
	if !l.CreatedOn.IsZero() {
		<script>
			button = document.getElementById("deleteButton");
			button.addEventListener("htmx:configRequest", (event) => {
				event.detail.headers["X-CSRF-Token"] =
					document.getElementById("csrf_token").value;
			});
		</script>
	}
}

templ Label(l models.Logistic) {
	{{
		var contact string
		if len(l.Visitor.Phone) > 0 {
			contact = l.Visitor.Phone
		} else if len(l.Visitor.Email) > 0 {
			contact = l.Visitor.Email
		}
	}}
	<div id="label" class="col-span-full">
		<input type="hidden" name="label" value={ l.Label }/>
		<div class="not-prose card md:card-side bg-base-300 shadow-xl">
			if len(l.Label)>0 {
				<figure class="md:w-56">
					<img src={ "/static/labels/" + l.Label } alt="Label"/>
				</figure>
				<div class="card-body">
					<h2 class="card-title">Label existiert!</h2>
					<p>
						Du kannst das Label beliebig oft ausdrucken.
					</p>
					<p>
						Bei Änderungen wird das Label gelöscht!
					</p>
					<div class="card-actions justify-center md:justify-end">
						<a
							class="btn btn-info loaded-content"
							hx-post={ "/admin/logistics/" + strconv.Itoa(l.ID) + "/label/print" }
							id="printbutton"
							hx-target="#printbutton"
							hx-indicator="#printbuttonload, #printbutton"
							hx-swap="outerHTML"
							hx-confirm="Überprüfe, dass der Label-drucker (neben dem self-checkin terminal) eingeschaltet ist: Grünes Licht leuchtet!"
						>
							Label ausdrucken
						</a>
						<div id="printbuttonload" class="btn btn-disabled htmx-indicator">
							<span class="loading loading-spinner"></span>Drucke Label
						</div>
						<a
							hx-post={ "/admin/logistics/" + strconv.Itoa(l.ID) + "/label/delete" }
							class="btn btn-warning"
							hx-target="#label"
						>Label löschen</a>
					</div>
				</div>
			} else {
				<div class="card-body">
					<h2 class="card-title">Label existiert nicht</h2>
					<p>
						Du kannst ein neues Label mit folgenden Informationen generieren:
					</p>
					<p>
						<strong>Lagerplatz: </strong> { strconv.Itoa(l.Number) }
					</p>
					<p>
						<strong>Grösse: </strong> { l.Category.CatName }
					</p>
					<p>
						<strong>Gehört: </strong> { l.Visitor.FirstName } { l.Visitor.FamilyName }
					</p>
					<p>
						<strong>Reserviert bis: </strong> { l.EndDate.Format("02.01.2006") }
					</p>
					<p>
						<strong>Kontakt: </strong> { contact }
					</p>
					<div class="card-actions justify-center md:justify-end">
						<a
							class="btn btn-info"
							hx-target="#label"
							hx-post={ "/admin/logistics/" + strconv.Itoa(l.ID) + "/label" }
							hx-swap="outerHTML"
						>
							Label generieren
						</a>
					</div>
				</div>
			}
		</div>
	</div>
}

templ SucessButton(l models.Logistic) {
	<a
		hx-post={ "/admin/logistics/" + strconv.Itoa(l.ID) + "/label/print" }
		class="btn btn-success"
		id="printbutton"
		hx-target="#printbutton"
		hx-swap="outerHTML"
	>Label wurde ausgedruckt</a>
}

templ ErrorButton(s string) {
	<div class="btn btn-error">{ s }</div>
}

templ LogisticsBill() {
	<form class="grid grid-cols-2 items-center gap-3 ">
		@ui.CSRF()
		<div class="prose col-span-full">
			<h2>Rechnung erstellen</h2>
		</div>
		<!-- form for all places -->
		<div id="assignForm" class={ "col-span-full grid grid-cols-2 gap-3" }>
			<form id="filterForm" class="mb-3 w-full col-span-2 md:col-span-1" novalidate>
				@ui.CSRF()
				<label class="input flex items-center gap-2">
					<span class="text-3xl i-mdi-magnify"></span>
					<input
						hx-post={ "/admin/visitors/selectbox/?logistics" }
						hx-trigger="input changed delay:500ms, search"
						hx-target="#memberSelect"
						placeholder="Suche nach Name, Vorname oder Ort..."
						type="search"
						id="search_term"
						name="search_term"
						class="grow"
					/>
				</label>
			</form>
			<div
				hx-get={ "/admin/visitors/selectbox/" }
				hx-trigger="load"
				id="memberSelect"
				class="mb-3 col-span-2 md:col-span-1"
			></div>
		</div>
		<!-- error handling for app and post buttons -->
	</form>
	<!-- list of logistic places that match -->
	<div id="visitorID"></div>
	<div id="logisticsBillList" hx-get="/admin/logistics/billing/list" hx-trigger="load"></div>
	<div class="mt-4 flex justify-center w-full">
		<a class="btn btn-warning" href="/admin/logistics">
			Zurück zur Übersicht
		</a>
	</div>
}

templ BillList(logistics []models.Logistic, vID string) {
	<div class="prose col-span-full my-4">
		<h3>Verrechenbare Plätze</h3>
	</div>
	if len(logistics)>0 {
		<form>
			@ui.CSRF()
			<input name="vid" type="hidden" value={ vID }/>
			<div class="overflow-x-auto w-full">
				<table class="table table-pin-cols table-pin-rows">
					<!-- head -->
					<thead>
						<tr>
							<th>
								<label>
									<input id="masterCheckBox" type="checkbox" class="checkbox"/>
								</label>
							</th>
							<th>Nr.</th>
							<th>Kategorie</th>
							<th>Startdatum</th>
							<th>Enddatum</th>
							<th class="text-right">Preis</th>
						</tr>
					</thead>
					<tbody>
						<!-- start row -->
						for _, l := range logistics {
							<tr>
								<th>
									<label>
										<input name={ strconv.Itoa(l.ID) } type="checkbox" class="checkbox slavecheckbox"/>
									</label>
								</th>
								<td>
									{ strconv.Itoa(l.Number) }
								</td>
								<td>
									{ l.Category.CatName }
								</td>
								<td>
									{ l.StartDate.Format("02.01.2006") }
								</td>
								<td>
									{ l.EndDate.Format("02.01.2006") }
								</td>
								<td class="text-right" id={ "price-" + strconv.Itoa(l.ID) }>
									{ strconv.FormatFloat(l.Price, 'f', 2, 64) }
								</td>
							</tr>
						}
						<tr class="bg-base-200">
							<td></td>
							<td></td>
							<td></td>
							<td></td>
							<td class="font-bold text-right">
								TOTAL
							</td>
							<td id="total" class="font-bold text-right">
								0.00
							</td>
						</tr>
						<!-- end row -->
					</tbody>
					<!-- foot -->
				</table>
			</div>
			<div class="mt-6 flex gap-3 justify-center flex-col md:flex-row">
				<button
					type="button"
					class="btn btn-primary sendbutton loaded-content"
					hx-post="/admin/logistics/billing?send"
					hx-target="#logisticsBillList"
					id="mailbutton"
					hx-indicator="#loadbutton, #mailbutton"
					disabled
				>
					<span class="text-lg i-mdi-invoice-text-send"></span> Rechnung
					versenden
				</button>
				<div id="loadbutton" class="btn btn-disabled htmx-indicator">
					<span class="loading loading-spinner"></span>Bearbeite Anfrage
				</div>
				<button
					type="button"
					class="btn btn-secondary sendbutton loaded-content"
					hx-post="/admin/logistics/billing"
					hx-target="#logisticsBillList"
					id="savebutton"
					hx-indicator="#loadbutton, #savebutton"
					disabled
				>
					<span class="text-lg i-mdi-invoice-text-arrow-left"></span> Rechnung
					nur speichern
				</button>
			</div>
		</form>
		<!-- script for list -->
		<script>
			var masterCheckBox = document.getElementById("masterCheckBox");
			var allCheckBoxes = document.getElementsByClassName("slavecheckbox");
			var sendButtons = document.getElementsByClassName("sendbutton");
			var totalCell = document.getElementById("total");

			masterCheckBox.addEventListener("change", () => {
				if (masterCheckBox.checked) {
					for (let i = 0; i < allCheckBoxes.length; i++) {
						allCheckBoxes[i].checked = true;
					}
				} else {
					for (let i = 0; i < allCheckBoxes.length; i++) {
						allCheckBoxes[i].checked = false;
					}
				}
				handleButtons();
			});

			for (let i = 0; i < allCheckBoxes.length; i++) {
				allCheckBoxes[i].addEventListener("change", () => {
					handleButtons();
				});
			}

			// disable buttons or not, if something is selected
			function handleButtons() {
				var anyChecked = false;
				var total = 0.0;

				for (let i = 0; i < allCheckBoxes.length; i++) {
					if (allCheckBoxes[i].checked) {
						// set anyChecked to true if any checkbox is checked
						anyChecked = true;

						// get price of checked bill and add it to total
						var price = document.getElementById(
							"price-" + allCheckBoxes[i].name,
						);

						total += parseFloat(price.innerText);
					}
				}

				// set total field to calculated total
				totalCell.innerHTML = total.toFixed(2);

				// enable/disable buttons if a checkbox is checked
				for (let i = 0; i < sendButtons.length; i++) {
					if (anyChecked) {
						sendButtons[i].disabled = false;
					} else {
						sendButtons[i].disabled = true;
					}
				}
			}
		</script>
	} else {
		@layout.Warning("Keine verrechenbare Plätze für Auswahl")
	}
}
