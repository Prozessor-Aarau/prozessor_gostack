package supervisions

import "fmt"
import "github.com/faebut/prozessor_gostack/internal/models"
import "time"

type SupervisionCalendarData struct {
	Entries   []models.CalendarEntry
	StartDate time.Time
	Daycount  int
	PrevUrl   string
	NextUrl   string
}

var weekdayDE = map[time.Weekday]string{
	time.Monday:    "Mo",
	time.Tuesday:   "Di",
	time.Wednesday: "Mi",
	time.Thursday:  "Do",
	time.Friday:    "Fr",
	time.Saturday:  "Sa",
	time.Sunday:    "So",
}

var swissLoc = func() *time.Location {
	loc, err := time.LoadLocation("Europe/Zurich")
	if err != nil {
		return time.UTC
	}
	return loc
}()

func calDayHeader(t time.Time) string {
	return fmt.Sprintf("%s %s", weekdayDE[t.Weekday()], t.Format("02.01"))
}

func isToday(t time.Time) bool {
	now := time.Now().In(swissLoc)
	y1, m1, d1 := now.Date()
	y2, m2, d2 := t.In(swissLoc).Date()
	return y1 == y2 && m1 == m2 && d1 == d2
}

func calSlotLabel(slot, startHour, slotMinutes int) string {
	totalMinutes := startHour*60 + slot*slotMinutes
	return fmt.Sprintf("%02d:%02d", totalMinutes/60, totalMinutes%60)
}

func calStartSlot(t time.Time, startHour, slotMinutes int) int {
	local := t.In(swissLoc)
	return ((local.Hour()-startHour)*60 + local.Minute()) / slotMinutes
}

func calDurationSlots(start, end time.Time, slotMinutes int) int {
	slots := int(end.Sub(start).Minutes()) / slotMinutes
	if slots < 1 {
		return 1
	}
	return slots
}

func calEntriesForDay(entries []models.CalendarEntry, day time.Time) []models.CalendarEntry {
	y, m, d := day.In(swissLoc).Date()
	var result []models.CalendarEntry
	for _, e := range entries {
		ey, em, ed := e.GetStartTime().In(swissLoc).Date()
		if ey == y && em == m && ed == d {
			result = append(result, e)
		}
	}
	return result
}

func calEventStyle(entry models.CalendarEntry, startHour, slotMinutes int) string {
	startSlot := calStartSlot(entry.GetStartTime(), startHour, slotMinutes)
	durationSlots := calDurationSlots(entry.GetStartTime(), entry.GetEndTime(), slotMinutes)
	return fmt.Sprintf("--start-slot:%d;--duration-slots:%d;--col:%d;--total-cols:%d",
		startSlot, durationSlots, entry.GetColumn(), entry.GetTotalCols())
}

templ calOpeningHour(e *models.OpeningHour) {
	<div class="text-xs font-semibold leading-tight">
		{ e.StartTime.In(swissLoc).Format("15:04") } – { e.EndTime.In(swissLoc).Format("15:04") }
	</div>
	<div class="text-xs opacity-75 mt-1">
		if len(e.Supervisors) > 0 {
			for _, s := range e.Supervisors {
				<div>{ s.FirstName } { s.FamilyName }</div>
			}
		} else {
			<div>keine Aufsicht</div>
		}
	</div>
}

templ calEventBlock(e *models.Event) {
	<div class="text-xs font-semibold leading-tight">
		{ e.StartTime.Format("15:04") } – { e.EndTime.Format("15:04") }
	</div>
	<div class="text-xs opacity-75 mt-1">
		{ e.Title }
	</div>
}

templ calendarNavigation(data SupervisionCalendarData) {
	<div class="grid justify-items-center mb-2">
		<div class="join">
			<button type="button" class="join-item btn btn-secondary" hx-get={ data.PrevUrl } hx-target="#opening_hours" hx-swap="innerHTML">«</button>
			<button type="button" class="join-item btn" hx-get={ fmt.Sprintf("/admin/supervisions/opening_hours/%s/%d", time.Now().Format("2006-01-02"), data.Daycount) } hx-target="#opening_hours" hx-swap="innerHTML">{ data.StartDate.Format("02.01.2006") } - { data.StartDate.AddDate(0,0,data.Daycount-1).Format("02.01.2006") }</button>
			<button type="button" class="join-item btn btn-secondary" hx-get={ data.NextUrl } hx-target="#opening_hours" hx-swap="innerHTML">»</button>
		</div>
	</div>
}

templ SupervisionsCalendar(data SupervisionCalendarData) {
	<div class="cal-wrapper" data-prev={ data.PrevUrl } data-next={ data.NextUrl } data-current={ fmt.Sprintf("/admin/supervisions/opening_hours/%s/%d", data.StartDate.Format("2006-01-02"), data.Daycount) }>
		@calendarNavigation(data)
		<div class="cal-grid">
			<div class="cal-time-col">
				<div class="cal-header-cell"></div>
				for i := range 56 {
					<div class="cal-time-label">
						if i % 4 == 0 {
							{ calSlotLabel(i, 8, 15) }
						}
					</div>
				}
			</div>
			for d := range data.Daycount {
				{{ day := data.StartDate.AddDate(0, 0, d) }}
				<div class={ "cal-day-col", templ.KV("cal-day-today", isToday(day)) }>
					<div class="cal-day-header">{ calDayHeader(day) }</div>
					<div class="cal-day-body">
						for _, entry := range calEntriesForDay(data.Entries, day) {
							switch e := entry.(type) {
								case *models.OpeningHour:
									<div
										class={ "cal-event cursor-pointer", templ.KV("bg-success/30 border-success", len(e.Supervisors) > 1), templ.KV("bg-warning/30 border-warning", len(e.Supervisors) == 1) , templ.KV("bg-error/40 border-error", len(e.Supervisors) == 0) }
										style={ calEventStyle(entry, 8, 15) }
										hx-get={ fmt.Sprintf("/admin/supervisions/opening_hours/%d/supervision", e.ID) }
										hx-target="#supervision-modal-content"
										hx-swap="innerHTML"
										hx-on::after-request="supervision_modal.showModal()"
									>
										@calOpeningHour(e)
									</div>
								case *models.Event:
									<a href={ templ.URL(e.URL) } target="_blank">
										<div class="cal-event bg-info/30 border-info" style={ calEventStyle(entry, 8, 15) }>
											@calEventBlock(e)
										</div>
									</a>
							}
						}
					</div>
				</div>
			}
		</div>
	</div>
	<script>
		(function () {
			const wrapper = document.querySelector(".cal-wrapper");
			if (!wrapper) return;
			let startX = 0;
			wrapper.addEventListener(
				"touchstart",
				function (e) {
					startX = e.touches[0].clientX;
				},
				{ passive: true },
			);
			wrapper.addEventListener(
				"touchend",
				function (e) {
					const diff = startX - e.changedTouches[0].clientX;
					if (Math.abs(diff) < 50) return;
					const url = diff > 0 ? wrapper.dataset.next : wrapper.dataset.prev;
					if (url)
						htmx.ajax("GET", url, {
							target: "#opening_hours",
							swap: "innerHTML",
						});
				},
				{ passive: true },
			);
		})();
	</script>
}
