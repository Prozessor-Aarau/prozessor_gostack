package supervisions

import "fmt"
import "github.com/faebut/prozessor_gostack/view/layout"
import "github.com/faebut/prozessor_gostack/internal/models"
import "github.com/faebut/prozessor_gostack/view/ui"
import "time"

templ Supervisions(visitor models.Visitor) {
	@layout.App(true, visitor) {
		<div class="prose mb-10">
			<h1>Aufsichten</h1>
		</div>
		<div id="content">
			<div id="opening_hours" data-baseurl={ fmt.Sprintf("/admin/supervisions/opening_hours/%s/", time.Now().Format("2006-01-02")) }></div>
			<div>
				<button
					type="button"
					class="mt-3 btn btn-primary"
					hx-get="/admin/supervisions/opening_hours/new"
					hx-target="#create-form-content"
					hx-swap="innerHTML"
					onclick="create_modal.showModal()"
				>
					<span class="i-mdi-calendar-plus"></span> Öffnungszeiten erstellen
				</button>
				@createModal()
			</div>
		</div>
		<script>
			(function () {
				const el = document.getElementById("opening_hours");
				const dayCount = window.innerWidth < 480 ? 3 : 7;
				htmx.ajax("GET", el.dataset.baseurl + dayCount, {
					target: "#opening_hours",
					swap: "innerHTML",
				});
			})();
		</script>
	}
}

type OpeningHoursForm struct {
	StartDate     string `form:"start_date"`
	StartTime     string `form:"start_time"`
	EndTime       string `form:"end_time"`
	Repetition    bool   `form:"repetition"`
	RepetitionEnd string `form:"repetition_end"`
}

type OpeningHoursFormErrors struct {
	StartDate     string `form:"start_date"`
	StartTime     string `form:"start_time"`
	EndTime       string `form:"end_time"`
	RepetitionEnd string `form:"repetition_end"`
}

templ createModal() {
	<dialog id="create_modal" class="modal modal-bottom sm:modal-middle" x-data x-on:close-modal.window="$el.close()">
		<div class="modal-box">
			<div class="prose">
				<h2>Öffnungszeiten erfassen</h2>
			</div>
			<div id="create-form-content"></div>
		</div>
	</dialog>
}

templ CreateForm(data OpeningHoursForm, errors OpeningHoursFormErrors) {
	<p class="py-4">Start- und Enddatum, -zeit erfassen für die Öffnungszeit. Repetitionen aktivieren sowie ein Enddatum für Repetitionen, um das Datum wöchentlich zu repetieren</p>
	<form hx-post="/admin/supervisions/opening_hours" hx-target="#create-form-content" hx-swap="innerHTML" class="grid grid-cols-2 gap-1 sm:gap-3 overflow-y-auto p-1" novalidate x-data={ fmt.Sprintf(`{"repetition":%t}`, data.Repetition) }>
		@ui.CSRF()
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Startdatum <span class="text-error font-extrabold">*</span></legend>
			<input
				type="date"
				lang="de"
				id="start_date"
				name="start_date"
				class={ "input w-full", templ.KV("input-error", len(errors.StartDate) > 0) }
				value={ data.StartDate }
				required
			/>
			if len(errors.StartDate) > 0 {
				{ errors.StartDate }
			}
		</fieldset>
		<div></div>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Startzeit <span class="text-error font-extrabold">*</span></legend>
			<input
				type="time"
				step="900"
				lang="de"
				id="start_time"
				name="start_time"
				class={ "input w-full", templ.KV("input-error", len(errors.StartTime) > 0) }
				value={ data.StartTime }
				required
			/>
			if len(errors.StartTime) > 0 {
				{ errors.StartTime }
			}
		</fieldset>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Endzeit <span class="text-error font-extrabold">*</span></legend>
			<input
				type="time"
				step="900"
				lang="de"
				id="end_time"
				name="end_time"
				class={ "input w-full", templ.KV("input-error", len(errors.EndTime) > 0) }
				value={ data.EndTime }
				required
			/>
			if len(errors.EndTime) > 0 {
				{ errors.EndTime }
			}
		</fieldset>
		<div class="border-t border-dashed border-base-content/50 col-span-2"></div>
		<!-- toggle for repetition  -->
		<fieldset class="fieldset col-span-full gap-5">
			<label class="fieldset-label">
				<input id="toggleFree" name="repetition" type="checkbox" class="toggle toggle-success" checked?={ data.Repetition } @change="repetition = $event.target.checked"/>
				Datum repetieren 
			</label>
		</fieldset>
		<fieldset class="fieldset" x-show="repetition">
			<legend class="fieldset-legend">Ende der Repetition <span class="text-error font-extrabold">*</span></legend>
			<input
				type="date"
				lang="de"
				id="repetition_end"
				name="repetition_end"
				class={ "input w-full", templ.KV("input-error", len(errors.RepetitionEnd) > 0) }
				value={ data.RepetitionEnd }
				required
			/>
			if len(errors.RepetitionEnd) > 0 {
				{ errors.RepetitionEnd }
			}
		</fieldset>
		<div class="col-span-2 grid grid-cols-2 gap-3">
			<button type="button" class="btn btn-warning" onclick="create_modal.close()">abbrechen</button><button class="btn btn-success" type="submit">speichern</button>
		</div>
	</form>
}

type SupervisionCalendarData struct {
	Entries   []models.CalendarEntry
	StartDate time.Time
	Daycount  int
	PrevUrl   string
	NextUrl   string
}

var weekdayDE = map[time.Weekday]string{
	time.Monday:    "Mo",
	time.Tuesday:   "Di",
	time.Wednesday: "Mi",
	time.Thursday:  "Do",
	time.Friday:    "Fr",
	time.Saturday:  "Sa",
	time.Sunday:    "So",
}

func calDayHeader(t time.Time) string {
	return fmt.Sprintf("%s %s", weekdayDE[t.Weekday()], t.Format("02.01"))
}

func calSlotLabel(slot, startHour, slotMinutes int) string {
	totalMinutes := startHour*60 + slot*slotMinutes
	return fmt.Sprintf("%02d:%02d", totalMinutes/60, totalMinutes%60)
}

func calStartSlot(t time.Time, startHour, slotMinutes int) int {
	return ((t.Hour()-startHour)*60 + t.Minute()) / slotMinutes
}

func calDurationSlots(start, end time.Time, slotMinutes int) int {
	slots := int(end.Sub(start).Minutes()) / slotMinutes
	if slots < 1 {
		return 1
	}
	return slots
}

func calEntriesForDay(entries []models.CalendarEntry, day time.Time) []models.CalendarEntry {
	y, m, d := day.Date()
	var result []models.CalendarEntry
	for _, e := range entries {
		ey, em, ed := e.GetStartTime().Date()
		if ey == y && em == m && ed == d {
			result = append(result, e)
		}
	}
	return result
}

func calEventStyle(entry models.CalendarEntry, startHour, slotMinutes int) string {
	startSlot := calStartSlot(entry.GetStartTime(), startHour, slotMinutes)
	durationSlots := calDurationSlots(entry.GetStartTime(), entry.GetEndTime(), slotMinutes)
	return fmt.Sprintf("--start-slot:%d;--duration-slots:%d;--col:%d;--total-cols:%d",
		startSlot, durationSlots, entry.GetColumn(), entry.GetTotalCols())
}

templ SupervisionsCalendar(data SupervisionCalendarData) {
	<div class="cal-wrapper" data-prev={ data.PrevUrl } data-next={ data.NextUrl }>
		<div class="flex gap-2 mb-2">
			<button type="button" class="btn btn-sm btn-ghost" hx-get={ data.PrevUrl } hx-target="#opening_hours" hx-swap="innerHTML">
				<span class="i-mdi-chevron-left"></span>
			</button>
			<button type="button" class="btn btn-sm btn-ghost" hx-get={ data.NextUrl } hx-target="#opening_hours" hx-swap="innerHTML">
				<span class="i-mdi-chevron-right"></span>
			</button>
		</div>
		<div class="cal-grid">
			<div class="cal-time-col">
				<div class="cal-header-cell"></div>
				for i := range 56 {
					<div class="cal-time-label">
						if i % 4 == 0 {
							{ calSlotLabel(i, 8, 15) }
						}
					</div>
				}
			</div>
			for d := range data.Daycount {
				{{ day := data.StartDate.AddDate(0, 0, d) }}
				<div class="cal-day-col">
					<div class="cal-day-header">{ calDayHeader(day) }</div>
					<div class="cal-day-body">
						for _, entry := range calEntriesForDay(data.Entries, day) {
							switch e := entry.(type) {
								case *models.OpeningHour:
									<div class={ "cal-event ", templ.KV("bg-primary/30 border-primary", len(e.Supervisors) > 0),templ.KV("bg-error/40 border-error", len(e.Supervisors) == 0 ) } style={ calEventStyle(entry, 8, 15) }>
										@calOpeningHour(e)
									</div>
								case *models.CalEvent:
									<div class="cal-event bg-secondary/20 border-secondary" style={ calEventStyle(entry, 8, 15) }>
										@calEventBlock(e)
									</div>
							}
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ calOpeningHour(e *models.OpeningHour) {
	<div class="text-xs font-semibold leading-tight">
		{ e.StartTime.Format("15:04") } – { e.EndTime.Format("15:04") }
	</div>
	<div class="text-xs opacity-75 mt-1">
		if len(e.Supervisors) > 0 {
			for _, s := range e.Supervisors {
				<div>{ s.FirstName } { s.FamilyName }</div>
			}
		} else {
			<div>keine Aufsicht</div>
		}
	</div>
}

templ calEventBlock(e *models.CalEvent) {
	<a href={ templ.URL(e.URL) } class="block text-xs font-semibold leading-tight">
		{ e.Title }
	</a>
}
