package supervisions

import "fmt"
import "github.com/faebut/prozessor_gostack/view/layout"
import "github.com/faebut/prozessor_gostack/internal/models"
import "github.com/faebut/prozessor_gostack/view/ui"
import "github.com/faebut/prozessor_gostack/internal/helpers"
import "time"

templ Supervisions(visitor models.Visitor) {
	{{
		todayString := time.Now().Format("2006-01-02")
		dayCount := 7
	}}
	@layout.App(true, visitor) {
		<div class="prose mb-10">
			<h1>Aufsichten</h1>
		</div>
		<div id="content">
			<div>
				<button
					type="button"
					class="mt-3 btn btn-primary"
					hx-get="/admin/supervisions/opening_hours/new"
					hx-target="#create-form-content"
					hx-swap="innerHTML"
					onclick="create_modal.showModal()"
				>
					<span class="i-mdi-calendar-plus"></span> Öffnungszeiten erstellen
				</button>
				@createModal()
			</div>
			<div id="opening_hours" hx-get={ templ.URL(fmt.Sprintf("/admin/supervisions/opening_hours/%s/%d", todayString, dayCount)) } hx-trigger="load"></div>
		</div>
	}
}

type OpeningHoursForm struct {
	StartDate     string `form:"start_date"`
	StartTime     string `form:"start_time"`
	EndTime       string `form:"end_time"`
	Repetition    bool   `form:"repetition"`
	RepetitionEnd string `form:"repetition_end"`
}

type OpeningHoursFormErrors struct {
	StartDate     string `form:"start_date"`
	StartTime     string `form:"start_time"`
	EndTime       string `form:"end_time"`
	RepetitionEnd string `form:"repetition_end"`
}

templ createModal() {
	<dialog id="create_modal" class="modal modal-bottom sm:modal-middle" x-data x-on:close-modal.window="$el.close()">
		<div class="modal-box">
			<div class="prose">
				<h2>Öffnungszeiten erfassen</h2>
			</div>
			<div id="create-form-content"></div>
		</div>
	</dialog>
}

templ CreateForm(data OpeningHoursForm, errors OpeningHoursFormErrors) {
	<p class="py-4">Start- und Enddatum, -zeit erfassen für die Öffnungszeit. Repetitionen aktivieren sowie ein Enddatum für Repetitionen, um das Datum wöchentlich zu repetieren</p>
	<form hx-post="/admin/supervisions/opening_hours" hx-target="#create-form-content" hx-swap="innerHTML" class="grid grid-cols-2 gap-1 sm:gap-3 overflow-y-auto p-1" novalidate x-data={ fmt.Sprintf(`{"repetition":%t}`, data.Repetition) }>
		@ui.CSRF()
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Startdatum <span class="text-error font-extrabold">*</span></legend>
			<input
				type="date"
				lang="de"
				id="start_date"
				name="start_date"
				class={ "input w-full", templ.KV("input-error", len(errors.StartDate) > 0) }
				value={ data.StartDate }
				required
			/>
			if len(errors.StartDate) > 0 {
				{ errors.StartDate }
			}
		</fieldset>
		<div></div>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Startzeit <span class="text-error font-extrabold">*</span></legend>
			<input
				type="time"
				step="900"
				lang="de"
				id="start_time"
				name="start_time"
				class={ "input w-full", templ.KV("input-error", len(errors.StartTime) > 0) }
				value={ data.StartTime }
				required
			/>
			if len(errors.StartTime) > 0 {
				{ errors.StartTime }
			}
		</fieldset>
		<fieldset class="fieldset">
			<legend class="fieldset-legend">Endzeit <span class="text-error font-extrabold">*</span></legend>
			<input
				type="time"
				step="900"
				lang="de"
				id="end_time"
				name="end_time"
				class={ "input w-full", templ.KV("input-error", len(errors.EndTime) > 0) }
				value={ data.EndTime }
				required
			/>
			if len(errors.EndTime) > 0 {
				{ errors.EndTime }
			}
		</fieldset>
		<div class="border-t border-dashed border-base-content/50 col-span-2"></div>
		<!-- toggle for repetition  -->
		<fieldset class="fieldset col-span-full gap-5">
			<label class="fieldset-label">
				<input id="toggleFree" name="repetition" type="checkbox" class="toggle toggle-success" checked?={ data.Repetition } @change="repetition = $event.target.checked"/>
				Datum repetieren 
			</label>
		</fieldset>
		<fieldset class="fieldset" x-show="repetition">
			<legend class="fieldset-legend">Ende der Repetition <span class="text-error font-extrabold">*</span></legend>
			<input
				type="date"
				lang="de"
				id="repetition_end"
				name="repetition_end"
				class={ "input w-full", templ.KV("input-error", len(errors.RepetitionEnd) > 0) }
				value={ data.RepetitionEnd }
				required
			/>
			if len(errors.RepetitionEnd) > 0 {
				{ errors.RepetitionEnd }
			}
		</fieldset>
		<div class="col-span-2 grid grid-cols-2 gap-3">
			<button type="button" class="btn btn-warning" onclick="create_modal.close()">abbrechen</button><button class="btn btn-success" type="submit">speichern</button>
		</div>
	</form>
}

templ SupervisionsCalendar(oh []models.OpeningHour, prev, next string) {
	<button type="button" hx-swap="innerHTML" hx-target="#opening_hours" hx-get={ prev }>Previous</button>
	<button type="button" hx-swap="innerHTML" hx-target="#opening_hours" hx-get={ next }>Next</button>
	<ul>
		for _, v := range oh {
			<li>{ helpers.HumanDate(v.StartTime) } { helpers.HumanDate(v.EndTime) }</li>
		}
	</ul>
}
