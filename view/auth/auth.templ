package auth

import (
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
)

templ Login() {
	@layout.App(false, models.Visitor{}) {
		<!-- Login Form -->
		<div class="flex flex-col items-center">
			<div class="prose">
				<h2 class="mt-8">Login Prozessor DB</h2>
			</div>
			@LoginForm(LoginParams{}, LoginErrors{})
		</div>
	}
}

type LoginErrors struct {
	Email              string
	Password           string
	InvalidCredentials string
}

type LoginParams struct {
	Email    string
	Password string
}

templ LoginForm(params LoginParams, errors LoginErrors) {
	<!-- start of Form -->
	<form
		class="flex flex-col items-center gap-6 p-5 pt-10 w-full max-w-sm"
		hx-post="/login"
		hx-swap="outerHTML"
		novalidate
	>
		@ui.CSRF()
		<fieldset
			class={ "fieldset w-full bg-base-200 border border-base-300 p-4 rounded-box" , templ.KV("border-error",
    len(errors.InvalidCredentials)>0) }
		>
			<legend class="fieldset-legend">Login</legend>
			<label class="fieldset-label"><span class="i-mdi-email"></span>Email</label>
			<input
				class={ "input" , templ.KV("input-error", len(errors.InvalidCredentials)> 0 ||
    len(errors.Email)> 0) }
				type="email"
				name="email"
				placeholder="Email"
				value={ params.Email }
			/>
			if len(errors.Email) > 0 {
				<p class="fieldset-label text-error">{ errors.Email }</p>
			}
			<label class="fieldset-label mt-4"><span class="i-mdi-key"></span>Password</label>
			<input
				class={ "input" , templ.KV("input-error", len(errors.InvalidCredentials)> 0 || len(errors.Password)> 0) }
				type="password"
				name="password"
				placeholder="Password"
				value={ params.Password }
			/>
			if len(errors.Password) > 0 {
				<p class="fieldset-label text-error">{ errors.Password }</p>
			}
			if len(errors.InvalidCredentials) > 0 {
				<div class="mt-4">
					@layout.Error(errors.InvalidCredentials)
				</div>
			}
			<button type="submit" class="btn btn-neutral mt-4">Login</button>
		</fieldset>
	</form>
}

templ CreateLogin(visitor CreateLoginParams, errors CreateLoginErrors) {
	@layout.App(false, models.Visitor{}) {
		<!-- Login Form -->
		<div class="flex flex-col items-center">
			<div class="prose">
				<h2 class="mt-8">Willkommen beim Prozessor { visitor.FirstName }</h2>
			</div>
			@CreateLoginForm(visitor, errors)
		</div>
	}
}

type CreateLoginErrors struct {
	AppError      string
	Password      string
	PasswordCheck string
}

type CreateLoginParams struct {
	FirstName string
	Email     string
	Password  string
}

templ CreateLoginForm(params CreateLoginParams, errors CreateLoginErrors) {
	if len(errors.AppError) > 0 {
		<div class="m-10 pt-10">
			@layout.Error(errors.AppError)
		</div>
	} else {
		<!-- start of Form -->
		<form
			class="flex flex-col items-center gap-6 p-5 pt-10 w-full max-w-lg"
			hx-post="/createlogin"
			hx-swap="outerHTML"
			novalidate
		>
			@ui.CSRF()
			<input type="hidden" id="email" name="email" value={ params.Email }/>
			<input type="hidden" id="first_name" name="first_name" value={ params.FirstName }/>
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">Passwort ändern</span>
				</div>
				<input
					type="password"
					name="password"
					id="password"
					class={ "input" , templ.KV("input-error", len(errors.Password)>
    0) }
				/>
				if len(errors.Password) > 0 {
					<div class="label">
						<span class="label-text text-error">{ errors.Password }</span>
					</div>
				}
			</label>
			<label class="form-control w-full">
				<div class="label">
					<span class="label-text">neues Passwort wiederholen</span>
				</div>
				<input
					type="password"
					name="password_check"
					id="password_check"
					class={ "input" , templ.KV("input-error",
      len(errors.PasswordCheck)> 0) }
				/>
				if len(errors.PasswordCheck) > 0 {
					<div class="label">
						<span class="label-text text-error">{ errors.PasswordCheck }</span>
					</div>
				}
			</label>
			<div class="mt-6 grid grid-cols-1 justify-center">
				<input type="submit" class="btn btn-primary px-10" value="Login Erstellen"/>
			</div>
		</form>
	}
}
