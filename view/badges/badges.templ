package badges

import (
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
	"strconv"
)

templ Badges(visitor models.Visitor) {
	@layout.App(true, visitor) {
		{{ prm := ctx.Value("permission").(models.Role) }}
		<div class="prose mb-10">
			<h1>Badges</h1>
		</div>
		<div id="content">
			@badgesFilter()
			<div id="badgesList" hx-get="/admin/badges/list" hx-trigger="load"></div>
			if prm.EditBadge {
				<div>
					<button type="button" class="mt-3 btn btn-primary" hx-target="#content" hx-get="/admin/badges/create">
						<span class="i-mdi-key-add"></span> Badge hinzufügen
					</button>
				</div>
			}
		</div>
	}
}

templ badgesFilter() {
	<div class="border-base-content/20 border rounded-md dark:rounded-lg bg-base-100 my-4 p-4">
		<h2 class="font-bold text-xl mb-3">Suchfilter</h2>
		<form id="filterForm" novalidate>
			<div class="grid grid-cols-5 gap-5 items-center">
				@ui.CSRF()
				<label class="input flex items-center gap-2 col-span-4 md:col-span-2">
					<span class="text-3xl i-mdi-magnify"></span>
					<input
						type="text"
						id="filter_string"
						name="filter_string"
						class="grow"
						placeholder="Suche nach Badge Nummer..."
					/>
					<!-- how to implement this button? should reset field -->
					<button id="fieldreset" class="ml-3 btn btn-neutral btn-outline btn-xs btn-circle">
						<span class="i-mdi-close"></span>
					</button>
				</label>
				<label class="form-control w-full max-w-xs col-span-5 md:col-span-1">
					<select name="inuse" id="inuse" class="select select-bordered">
						<option value="all">Verfügbarkeit (alle)</option>
						<option value="gone">ausgeliehen</option>
						<option value="here">verfügbar</option>
					</select>
				</label>
				<label class="form-control w-full max-w-xs col-span-5 md:col-span-1">
					<select name="type" id="type" class="select select-bordered">
						<option value="all">Typ (alle)</option>
						<option value="new">neue Badges</option>
						<option value="old">alte Badges</option>
					</select>
				</label>
				<div class="col-span-5 md:col-span-1 grid grid-cols-2 justify-items-center justify-around gap-3">
					<button
						type="submit"
						hx-post="/admin/badges/list"
						hx-target="#badgesList"
						class="btn btn-success btn-outline btn-circle"
					><span class="i-mdi-magnify text-xl"></span></button>
					<a href="/admin/badges" class="btn btn-error btn-outline btn-circle">
						<span class="i-mdi-close text-xl"></span>
					</a>
				</div>
			</div>
		</form>
	</div>
	<script>
  searchField = document.querySelector("#filter_string")

  document.getElementById("fieldreset").addEventListener("click", function (event) {
    event.preventDefault();
    searchField.value = "";
  });
</script>
}

templ BadgesList(badges []models.Badge) {
	{{ prm := ctx.Value("permission").(models.Role) }}
	if len(badges) > 0 {
		for _, b := range badges {
			<div
				class="hover:bg-base-200 cursor-pointer grid grid-cols-6 text-sm p-3 py-4 items-center gap-3 border-dashed border-b border-base-content/50"
			>
				<div class="col-span-1">{ strconv.Itoa(b.Number) }</div>
				<div class="col-span-1 text-2xl flex items-center">
					if len(b.VisitorID) > 0 {
						if b.VisitorAboValid {
							<span class="i-mdi-check-circle text-success"></span>
						} else {
							<span class="i-mdi-check-circle text-error"></span>
						}
					} else if len(b.ExternFirstName) > 0 {
						<span class="i-mdi-check-circle text-warning"></span>
					} else {
						<span class="i-mdi-close-circle-outline"></span>
					}
				</div>
				<div class="col-span-4 md:col-span-1">{ b.UID }</div>
				<div class="col-span-5 md:col-span-2 text-right md:text-left">
					{ b.VisitorFirstName }
					{ b.VisitorFamilyName }
					if len(b.ExternFirstName) > 0 {
						{ b.ExternFirstName } { b.ExternFamilyName }, { b.ExternPurpose }
					}
				</div>
				<div class="col-span-1 flex justify-end items-center">
					<a
						class={ "btn btn-sm btn-circle btn-primary" , templ.KV("btn-disabled", !prm.AssignBadge) }
						hx-get={ "/admin/badges/" + strconv.Itoa(b.ID) }
						hx-target="#main"
					>
						<span class="i-mdi-lead-pencil"></span>
					</a>
				</div>
			</div>
		}
	} else {
		<div class="my-10">
			@layout.Warning("keine Suchergebnisse")
		</div>
	}
}

type BadgeCreateErrors struct {
	Number string
	UID    string
}

templ BadgeCreate(badge models.Badge, errors BadgeCreateErrors) {
	<form class="flex flex-wrap gap-3" novalidate>
		@ui.CSRF()
		<div class="prose col-span-full">
			<h2>Neuen Badge erstellen</h2>
		</div>
		<label class="form-control w-full">
			<div class="label">
				<span class="label-text">Nummer <span class="text-error font-extrabold">*</span></span>
			</div>
			<input
				type="text"
				placeholder="Badge Nummer"
				class={ "input w-full" , templ.KV("input-error", len(errors.Number)>0) }
				value={ strconv.Itoa(badge.Number) }
				name="number"
				required
			/>
			if len(errors.Number) > 0 {
				<div class="label">
					<span class="label-text text-error">{ errors.Number }</span>
				</div>
			}
		</label>
		<div class="flex w-full gap-3 items-end">
			<label id="badge" class="form-control w-full">
				<div class="label">
					<span class="label-text">
						UUID <span class="text-error font-extrabold">*</span>
					</span>
				</div>
				<input
					type="text"
					placeholder="Badge UUID"
					class={ "input w-full" , templ.KV("input-error", len(errors.UID)> 0) }
					value={ badge.UID }
					name="uid"
					required
				/>
				if len(errors.UID) > 0 {
					<div class="label">
						<span class="label-text text-error">{ errors.UID }</span>
					</div>
				}
			</label>
			<div
				class="btn btn-outline btn-circle btn-secondary"
				hx-disabled-elt="this"
				hx-target="#statusMessage"
				onclick="hideMessage()"
				hx-get="/admin/badges/scan"
				hx-indicator="#statusMessage,#indicator"
			>
				<span class="i-mdi-nfc-variant text-2xl"></span>
			</div>
		</div>
		<div id="indicator" class="flex htmx-indicator gap-3 items-center">
			<span id="indicator" class="htmx-indicator loading loading-infinity loading-lg"></span>
			<span class="font-bold">
				Badge
				wird gescannt...
			</span>
		</div>
		<div id="statusMessage" class="loaded-content"></div>
		<div class=" col-span-full text-sm mt-3">
			<span class="text-error font-extrabold">*</span> diese Felder sind zwingend
			auszufüllen und die Werte dürfen noch nicht vergeben sein.
		</div>
		<div class="col-span-full w-full gap-3 flex mt-3 items-center justify-center flex-col md:flex-row">
			<a class="btn btn-success" hx-post="/admin/badges/create" hx-target="#content">
				Speichern
			</a>
			<a href="/admin/badges" class="btn btn-warning">
				<span class="i-mdi-cancel-bold"></span>
				Abbrechen
			</a>
		</div>
	</form>
	<script>
  hideMessage = function () {
    document.getElementById("statusMessage").innerHTML = "";
  }
</script>
}

templ BadgeReturnUID(uid string, err string) {
	if len(err) > 0 {
		if err == "noreader" {
			<span class="text-error">Kein Lesegerät verbunden!</span>
		}
		if err == "deadline" {
			<span class="text-error">Dies hat zu lange gedauert, versuchs nochmals!</span>
		}
	} else {
		<label id="badge" class="form-control w-full col-span-full md:col-span-1">
			<div class="label">
				<span class="label-text">UUID <span class="text-error font-extrabold">*</span></span>
			</div>
			<input type="text" placeholder="Badge UUID" class="input w-full " value={ uid } name="uid"/>
		</label>
	}
}

type BadgeEditErrors struct {
	Number           string
	UID              string
	Member           string
	ExternFirstName  string
	ExternFamilyName string
	ExternCity       string
	ExternPhone      string
	ExternEmail      string
	ExternPurpose    string
}

type BadgeEditFormParams struct {
	InUse  bool
	Extern bool
}

templ BadgeEdit(badge models.Badge, errors BadgeEditErrors, visitor models.Visitor, params BadgeEditFormParams) {
	{{ prm := ctx.Value("permission").(models.Role) }}
	<form class="grid grid-cols-2 items-center gap-3 ">
		@ui.CSRF()
		<div class="prose col-span-full">
			<h2>Badge Nr. { strconv.Itoa(badge.Number) } bearbeiten</h2>
		</div>
		<label class="form-control w-full  col-span-full md:col-span-1">
			<div class="label">
				<span class="label-text">Nummer</span>
			</div>
			if prm.EditBadge {
				<input
					type="text"
					placeholder="Badge Nummer"
					class={ "input w-full" , templ.KV("input-error", len(errors.Number)>0) }
					value={ strconv.Itoa(badge.Number) }
					name="number"
					required
				/>
				if len(errors.Number) > 0 {
					<div class="label">
						<span class="label-text text-error">{ errors.Number }</span>
					</div>
				}
			} else {
				<input type="hidden" value={ strconv.Itoa(badge.Number) } name="number"/>
				<span>{ strconv.Itoa(badge.Number) }</span>
			}
		</label>
		<label class="form-control w-full  col-span-full md:col-span-1">
			<div class="label">
				<span class="label-text">UUID</span>
			</div>
			if prm.EditBadge {
				<input type="text" placeholder="Badge UUID" class="input w-full " value={ badge.UID } name="uid"/>
			} else {
				<input type="hidden" value={ badge.UID } name="uid"/>
				<span>{ badge.UID }</span>
			}
		</label>
		<div class="form-control">
			<label class="label cursor-pointer justify-start">
				<input
					id="toggleUsed"
					name="inuse"
					type="checkbox"
					class="toggle toggle-success"
					checked?={ len(badge.VisitorID)>
      0 ||
      len(badge.ExternFirstName) > 0 || params.InUse }
				/>
				<span class="label-text pl-3">Badge in Benutzung</span>
			</label>
		</div>
		<!-- start of form for badge user -->
		<div
			class={ "col-span-full border-t border-base-content/50 border-dashed pt-5 grid-cols-subgrid" , templ.KV("hidden",
    len(badge.VisitorID)<1&&len(badge.ExternFirstName)<1&&!params.InUse) }
			id="selectUser"
		>
			<div class="form-control col-span-full">
				<label class="label cursor-pointer justify-start">
					<input
						id="toggleExtern"
						name="extern"
						type="checkbox"
						class="toggle toggle-success"
						checked?={ 
          len(badge.ExternFirstName)>0 || params.Extern }
					/>
					<span class="label-text pl-3">Externe Nutzung</span>
				</label>
			</div>
			<div
				class={ "col-span-full mt-3 gap-3 grid grid-cols-2" , templ.KV("hidden", len(badge.ExternFirstName)>0 ||
      params.Extern) }
				id="selectInternal"
			>
				<form id="filterForm" class="mb-3 w-full col-span-2 md:col-span-1" novalidate>
					@ui.CSRF()
					<label class="input flex items-center gap-2">
						<span class="text-3xl i-mdi-magnify"></span>
						<input
							type="search"
							id="search_term"
							name="search_term"
							class="grow"
							placeholder="Suche nach Name, Vorname oder Ort..."
							hx-post={ "/admin/visitors/selectbox/" + badge.VisitorID }
							hx-trigger="input changed delay:500ms, search"
							hx-target="#memberSelect"
						/>
						<button id="fieldreset" class="ml-3 btn btn-neutral btn-outline btn-xs btn-circle">
							<span class="i-mdi-close"></span>
						</button>
					</label>
				</form>
				<div
					id="memberSelect"
					class="mb-3 col-span-2 md:col-span-1"
					hx-get={ "/admin/visitors/selectbox/" +
        badge.VisitorID }
					hx-trigger="load"
				></div>
			</div>
			if len(errors.Member)>0 {
				<div class="my-4">
					@layout.Error(errors.Member)
				</div>
			}
			<div
				class={ "col-span-full mt-3 gap-3 grid grid-cols-2" , templ.KV("hidden",
      len(badge.ExternFirstName)<1&&!params.Extern) }
				id="selectExternal"
			>
				<label class="form-control w-full  col-span-full md:col-span-1">
					<div class="label">
						<span class="label-text">Vorname Besitzer*in <span class="text-error font-extrabold">*</span></span>
					</div>
					<input
						class={ "input w-full" , templ.KV("input-error", len(errors.ExternFirstName)>0) }
						value={ badge.ExternFirstName }
						name="ext_firstname"
						type="text"
						placeholder="Vorname Besitzer*in"
					/>
					if len(errors.ExternFirstName)>0 {
						<div class="label">
							<span class="label-text text-error">{ errors.ExternFirstName }</span>
						</div>
					}
				</label>
				<label class="form-control w-full  col-span-full md:col-span-1">
					<div class="label">
						<span class="label-text">Nachname Besitzer*in <span class="text-error font-extrabold">*</span></span>
					</div>
					<input
						class={ "input w-full" , templ.KV("input-error", len(errors.ExternFamilyName)>0) }
						name="ext_familyname"
						type="text"
						placeholder="Nachname Besitzer*in"
						value={ badge.ExternFamilyName }
					/>
					if len(errors.ExternFamilyName)>0 {
						<div class="label">
							<span class="label-text text-error">{ errors.ExternFamilyName }</span>
						</div>
					}
				</label>
				<label class="form-control w-full  col-span-full md:col-span-1">
					<div class="label">
						<span class="label-text">Ort</span>
					</div>
					<input name="ext_city" type="text" placeholder="Ort" class="input w-full " value={ badge.ExternCity }/>
				</label>
				<label class="form-control w-full  col-span-full md:col-span-1">
					<div class="label">
						<span class="label-text">Telefonnummer <span class="text-error font-extrabold">**</span></span>
					</div>
					<input
						name="ext_phone"
						type="text"
						placeholder="Telefonnummer"
						class={ "input w-full" , templ.KV("input-error",
          len(errors.ExternPhone)>0) }
						value={ badge.ExternPhone }
					/>
					if len(errors.ExternPhone)>0 {
						<div class="label">
							<span class="label-text text-error">{ errors.ExternPhone }</span>
						</div>
					}
				</label>
				<label class="form-control w-full  col-span-full md:col-span-1">
					<div class="label">
						<span class="label-text">E-Mail <span class="text-error font-extrabold">**</span></span>
					</div>
					<input
						name="ext_email"
						type="text"
						placeholder="Email Adresse"
						class={ "input w-full" , templ.KV("input-error",
          len(errors.ExternEmail)>0) }
						value={ badge.ExternEmail }
					/>
					if len(errors.ExternEmail)>0 {
						<div class="label">
							<span class="label-text text-error">{ errors.ExternEmail }</span>
						</div>
					}
				</label>
				<label class="form-control w-full  col-span-full">
					<div class="label">
						<span class="label-text">Nutzungszweck <span class="text-error font-extrabold">*</span></span>
					</div>
					<textarea
						name="ext_purpose"
						type="text"
						placeholder="Nutzungszweck"
						class={ "textarea textarea-bordered h-24 w-full" , templ.KV("textarea-error", len(errors.ExternPurpose)>0) }
					>{ badge.ExternPurpose }</textarea>
					if len(errors.ExternPurpose)>0 {
						<div class="label">
							<span class="label-text text-error">{ errors.ExternPurpose }</span>
						</div>
					}
				</label>
				<div class="col-span-full text-sm">
					<span class="text-error font-extrabold">*</span> diese Felder sind zwingend
					auszufüllen
				</div>
				<div class="col-span-full text-sm">
					<span class="text-error font-extrabold">**</span> mindestens eine Angabe nötig
					(entweder/oder)
				</div>
			</div>
		</div>
		<!-- end for badge user -->
		<div class="col-span-full gap-3 flex mt-3 items-center justify-center flex-col md:flex-row">
			<a class="btn btn-success" hx-post={ "/admin/badges/" + strconv.Itoa(badge.ID) } hx-target="#main">
				Speichern
			</a>
			if len(badge.VisitorID)>0||len(badge.ExternFirstName)>0 {
				<a
					class="btn btn-error"
					hx-post={ "/admin/badges/reset/" + strconv.Itoa(badge.ID) }
					hx-confirm="Zuweisung für diesen Badge wirklich löschen?"
				>
					Zuweisung löschen
				</a>
			}
			<a href="/admin/badges" class="btn btn-warning">
				<span class="i-mdi-cancel-bold"></span>
				Abbrechen
			</a>
			if prm.EditBadge {
				<a
					id="deleteButton"
					class="btn btn-error btn-circle"
					hx-delete={ "/admin/badges/" + strconv.Itoa(badge.ID) }
					hx-confirm="Badge wirklich löschen?"
				>
					<span class="i-mdi-trash text-2xl"></span>
				</a>
			}
		</div>
	</form>
	<!-- script for toggeling the fields -->
	<script>
  selectUser = document.querySelector("#selectUser")
  selectInternal = document.querySelector("#selectInternal")
  selectExternal = document.querySelector("#selectExternal")

  document.getElementById("toggleUsed").addEventListener("change", function (event) {
    selectUser.classList.toggle("hidden")
  });

  document.getElementById("toggleExtern").addEventListener("change", function (event) {
    selectInternal.classList.toggle("hidden")
    selectExternal.classList.toggle("hidden")
  });
</script>
	<!-- this script is needed for the delete button to send the CSRF-Token -->
	if prm.EditBadge {
		<script>
  button = document.getElementById("deleteButton")
  button.addEventListener('htmx:configRequest', (event) => {
    event.detail.headers['X-CSRF-Token'] = document.getElementById('csrf_token').value
  })
</script>
	}
}
