package statistics

import (
	"github.com/faebut/prozessor_gostack/internal/chart"
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/internal/render"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
	"github.com/go-echarts/go-echarts/v2/charts"
	"time"
)

templ Statistics(visitor models.Visitor) {
	{{ mindate, _ := time.Parse("2006-01-02", "2020-03-01") }}
	@layout.App(true, visitor) {
		<script src="https://go-echarts.github.io/go-echarts-assets/assets/echarts.min.js"></script>
		<div class="prose">
			<h1>Statistik</h1>
		</div>
		@filterField()
		@CardStack(Filter{MinDate: mindate, MaxDate: time.Now()})
	}
}

templ filterField() {
	{{
today := time.Now().Format("2006-01-02")
	}}
	<div class="border-base-content/20 border rounded-md dark:rounded-lg bg-base-100 my-4 p-4">
		<h2 class="font-bold text-xl mb-3">Suchfilter</h2>
		<form id="filterForm" novalidate>
			<div class="grid grid-cols-4 gap-5 items-start">
				@ui.CSRF()
				<label class="input flex items-center gap-2 col-span-2">
					<span class="text-3xl i-mdi-magnify"></span>
					<input
						type="date"
						id="min_date"
						name="min_date"
						class="grow"
						value="2020-03-01"
						min="2020-03-01"
						max={ today }
					/>
				</label>
				<label class="input flex items-center gap-2 col-span-2">
					<span class="text-3xl i-mdi-magnify"></span>
					<input type="date" id="max_date" name="max_date" class="grow" value={ today } min="2020-03-01" max={ today }/>
				</label>
				<div class="col-span-4 grid grid-cols-2 justify-items-center gap-3">
					<button
						type="submit"
						hx-post="/admin/statistics/charts/filter"
						hx-target="#cardStack"
						hx-swap="outerHTML"
						class="btn btn-success btn-outline"
					><span class="i-mdi-funnel"></span> filtern</button>
					<a href="/admin/statistics" class="btn btn-error btn-outline">
						<span class="i-mdi-close"></span> zurücksetzen
					</a>
				</div>
			</div>
		</form>
	</div>
}

type Filter struct {
	MinDate time.Time
	MaxDate time.Time
}

templ CardStack(filter Filter) {
	{{
stringMin := filter.MinDate.Format("2006-01-02")
stringMax := filter.MaxDate.Format("2006-01-02")
	}}
	<div id="cardStack" class="mt-6 flex flex-col gap-5">
		<div
			id="keyfigures-chart"
			hx-get={ "/admin/statistics/charts/keyfigures?min=" + stringMin + "&max=" + stringMax }
			hx-trigger="load"
		></div>
		<div
			id="visitors-chart"
			hx-get={ "/admin/statistics/charts/visitors?min=" + stringMin + "&max=" + stringMax }
			hx-trigger="load, refreshCharts from:document"
		></div>
		<div
			id="weekdays-chart"
			hx-get={ "/admin/statistics/charts/weekdays?min=" + stringMin + "&max=" + stringMax }
			hx-trigger="load, refreshCharts from:document"
		></div>
		<div
			id="ateliers-chart"
			hx-get={ "/admin/statistics/charts/ateliers?min=" + stringMin + "&max=" + stringMax }
			hx-trigger="load, refreshCharts from:document"
		></div>
		<div
			id="ages-chart"
			hx-get={ "/admin/statistics/charts/ages?min=" + stringMin + "&max=" + stringMax }
			hx-trigger="load, refreshCharts from:document"
		></div>
	</div>
	<script>
  (() => {
    function isDarkMode() {
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    document.addEventListener('htmx:configRequest', function (evt) {
      if (evt.detail.elt.id.includes('-chart') && evt.detail.elt.id !== 'keyfigures-chart') {
        const mode = isDarkMode() ? 'dark' : 'light';
        evt.detail.parameters.mode = mode;
      }
    });
  })()
  // Listen for changes and dispatch event
  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  mediaQuery.addEventListener('change', function () {
    document.dispatchEvent(new CustomEvent('refreshCharts'));
    console.log("mode changed");
  });

</script>
}

templ FigureCard(data models.ChartData, title string) {
	{{
type keyValue struct {
	key   string
	value float64
}

var figures []keyValue

for i, key := range data.AxisX {
	var fig keyValue
	fig.key = key
	fig.value = data.Data[0][i]
	figures = append(figures, fig)
}
	}}
	<div class="card bg-base-200 shadow-sm">
		German
		<div class="card-body">
			<div class="flex justify-between">
				<h2 class="text-3xl font-bold">{ title }</h2>
			</div>
			<div class="stats stats-vertical grid-cols-1 md:grid-cols-3">
				for _, data := range figures {
					<div class="stat">
						<div class="stat-title">{ data.key }</div>
						<div class="stat-value">{ render.FormatFloat(data.value, 0) }</div>
					</div>
				}
			</div>
		</div>
	</div>
}

templ Chart(graph *charts.Bar, title string) {
	<div class="card bg-base-200 shadow-sm">
		<div class="card-body">
			<div class="flex justify-between">
				<h2 class="text-3xl font-bold">{ title }</h2>
			</div>
			@chart.ConvertChartToTemplComponent(graph)
		</div>
	</div>
}

templ PieChart(graph *charts.Pie, title string) {
	<div class="card bg-base-200 shadow-sm">
		<div class="card-body">
			<div class="flex justify-between">
				<h2 class="text-3xl font-bold">{ title }</h2>
			</div>
			@chart.ConvertChartToTemplComponent(graph)
		</div>
	</div>
}
