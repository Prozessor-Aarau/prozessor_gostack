package calendar

import "github.com/faebut/prozessor_gostack/internal/models"

import "time"
import "github.com/faebut/prozessor_gostack/view/layout"
import "github.com/faebut/prozessor_gostack/internal/calendar"
import "fmt"

type CalendarData struct {
	Entries   []models.CalendarEntry
	StartDate time.Time
	Daycount  int
	PrevUrl   string
	NextUrl   string
}

templ calOpeningHour(e *models.OpeningHour) {
	<div class="text-xs font-semibold leading-tight">
		{ e.StartTime.In(calendar.SwissLoc).Format("15:04") } – { e.EndTime.In(calendar.SwissLoc).Format("15:04") }
	</div>
	<div class="text-xs opacity-75 mt-1">
		if len(e.Expertise) > 0 {
			Fachperson:
			for _, ex := range e.Expertise {
				<div>{ ex }</div>
			}
		} else {
			geöffnet
		}
	</div>
}

templ calEventBlock(e *models.Event) {
	<div class="text-xs font-semibold leading-tight">
		{ e.StartTime.Format("15:04") } – { e.EndTime.Format("15:04") }
	</div>
	<div class="text-xs opacity-75 mt-1">
		{ e.Title }
	</div>
}

templ calendarNavigation(data CalendarData) {
	<div class="grid justify-items-center mb-2">
		<div class="join">
			<button type="button" class="join-item btn btn-secondary" hx-get={ data.PrevUrl } hx-target="#opening_hours" hx-swap="innerHTML">«</button>
			<button type="button" class="join-item btn" hx-get={ fmt.Sprintf("/calendar/%s/%d", time.Now().Format("2006-01-02"), data.Daycount) } hx-target="#opening_hours" hx-swap="innerHTML">{ data.StartDate.Format("02.01.2006") } - { data.StartDate.AddDate(0,0,data.Daycount-1).Format("02.01.2006") }</button>
			<button type="button" class="join-item btn btn-secondary" hx-get={ data.NextUrl } hx-target="#opening_hours" hx-swap="innerHTML">»</button>
		</div>
	</div>
}

templ Calendar(baseUrl string) {
	@layout.App(false, models.Visitor{}) {
		<div id="opening_hours" data-baseurl={ fmt.Sprintf("%s/%s/", baseUrl, time.Now().Format("2006-01-02")) }></div>
		<script>
			(function () {
				const el = document.getElementById("opening_hours");
				const dayCount = window.innerWidth < 480 ? 3 : 7;
				htmx.ajax("GET", el.dataset.baseurl + dayCount, {
					target: "#opening_hours",
					swap: "innerHTML",
				});
			})();
		</script>
	}
}

templ calDetailStyles() {
	<style>
		.cal-event-expandable {
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
		}
		.cal-popover {
			position: fixed;
			z-index: 100;
			padding: 8px 10px;
			border-radius: 6px;
			border-left-width: 3px;
			border-left-style: solid;
			box-shadow: 0 6px 20px rgba(0,0,0,0.2);
			font-size: 0.75rem;
			line-height: 1.4;
			pointer-events: none;
			box-sizing: border-box;
			width: max-content;
		}
	</style>
	<script>
		(function() {
			var pop = null;
			var activeEl = null;

			function show(el) {
				if (activeEl === el) return;
				hide();
				activeEl = el;
				var scrollH = el.scrollHeight;
				var clientH = el.clientHeight;
				if (scrollH <= clientH + 2) return;

				pop = document.createElement('div');
				pop.className = 'cal-popover';
				pop.innerHTML = el.innerHTML;

				var cs = getComputedStyle(el);
				pop.style.backgroundColor = cs.backgroundColor;
				pop.style.borderLeftColor = cs.borderLeftColor;
				pop.style.color = cs.color;

				var rect = el.getBoundingClientRect();
				var body = el.closest('.cal-day-body');
				var bodyRect = body ? body.getBoundingClientRect() : rect;
				var dayCol = el.closest('.cal-day-col');
				var colRect = dayCol ? dayCol.getBoundingClientRect() : rect;
				var grid = el.closest('.cal-grid');
				var gridRect = grid ? grid.getBoundingClientRect() : bodyRect;

				document.body.appendChild(pop);

				var colW = colRect.width;
				pop.style.minWidth = colW + 'px';
				pop.style.maxWidth = (colW * 2) + 'px';

				var popH = pop.offsetHeight;
				var popW = pop.offsetWidth;

				var dayCols = grid ? grid.querySelectorAll('.cal-day-col') : [];
				var dayIndex = Array.prototype.indexOf.call(dayCols, dayCol);
				var isFirst = dayIndex <= 0;
				var isLast = dayIndex === dayCols.length - 1;

				var colCenterX = colRect.left + colRect.width / 2;
				var x;
				if (isFirst) {
					x = rect.left;
				} else if (isLast) {
					x = rect.right - popW;
				} else {
					x = colCenterX - popW / 2;
				}
				x = Math.max(gridRect.left, Math.min(x, gridRect.right - popW));

				var centerY = rect.top + rect.height / 2;
				var nearTop = (centerY - bodyRect.top) < popH / 2 + 8;
				var nearBottom = (bodyRect.bottom - centerY) < popH / 2 + 8;

				var y;
				if (nearTop) {
					y = rect.top;
				} else if (nearBottom) {
					y = rect.bottom - popH;
				} else {
					y = centerY - popH / 2;
				}
				y = Math.max(bodyRect.top, Math.min(y, bodyRect.bottom - popH));

				pop.style.left = x + 'px';
				pop.style.top = y + 'px';
			}

			function hide() {
				if (pop) {
					pop.remove();
					pop = null;
				}
				activeEl = null;
			}

			function bind(el) {
				if (el.dataset.calBound) return;
				el.dataset.calBound = '1';
				el.addEventListener('mouseenter', function() { show(el); });
				el.addEventListener('mouseleave', hide);
				el.addEventListener('focus', function() { show(el); });
				el.addEventListener('blur', hide);
			}

			function init() {
				document.querySelectorAll('.cal-event-expandable').forEach(bind);
			}
			init();
			new MutationObserver(init).observe(document.body, { childList: true, subtree: true });
		})();
	</script>
}

templ CalendarView(data CalendarData) {
	@calDetailStyles()
	@calendarNavigation(data)
	<div class="cal-grid">
		<div class="cal-time-col">
			<div class="cal-header-cell"></div>
			for i := range 56 {
				<div class="cal-time-label">
					if i % 4 == 0 {
						{ calendar.CalSlotLabel(i, 8, 15) }
					}
				</div>
			}
		</div>
		for d := range data.Daycount {
			{{ day := data.StartDate.AddDate(0, 0, d) }}
			<div class={ "cal-day-col", templ.KV("cal-day-today", calendar.IsToday(day)) }>
				<div class="cal-day-header">{ calendar.CalDayHeader(day) }</div>
				<div class="cal-day-body">
					for _, entry := range calendar.CalEntriesForDay(data.Entries, day) {
						switch e := entry.(type) {
							case *models.OpeningHour:
								<div
									class={ "cal-event flex flex-col bg-primary/30 border-primary", templ.KV("cal-event-expandable", len(e.Expertise) > 0) }
									style={ calendar.CalEventStyle(entry, 8, 15) }
									if len(e.Expertise) > 0 {
										tabindex="0"
									}
								>
									@calOpeningHour(e)
								</div>
							case *models.Event:
								<a href={ templ.URL(e.URL) }>
									<div class="cal-event bg-info/30 border-info" style={ calendar.CalEventStyle(entry, 8, 15) }>
										@calEventBlock(e)
									</div>
								</a>
						}
					}
				</div>
			</div>
		}
	</div>
	<script>
		(function () {
			const wrapper = document.querySelector(".cal-wrapper");
			if (!wrapper) return;
			let startX = 0;
			wrapper.addEventListener(
				"touchstart",
				function (e) {
					startX = e.touches[0].clientX;
				},
				{ passive: true },
			);
			wrapper.addEventListener(
				"touchend",
				function (e) {
					const diff = startX - e.changedTouches[0].clientX;
					if (Math.abs(diff) < 50) return;
					const url = diff > 0 ? wrapper.dataset.next : wrapper.dataset.prev;
					if (url)
						htmx.ajax("GET", url, {
							target: "#opening_hours",
							swap: "innerHTML",
						});
				},
				{ passive: true },
			);
		})();
	</script>
}
