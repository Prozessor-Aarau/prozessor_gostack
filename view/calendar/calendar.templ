package calendar

import "github.com/faebut/prozessor_gostack/internal/models"

import "time"

import "github.com/faebut/prozessor_gostack/internal/calendar"
import "fmt"

type CalendarData struct {
	Entries   []models.CalendarEntry
	StartDate time.Time
	Daycount  int
	PrevUrl   string
	NextUrl   string
}

templ calOpeningHour(e *models.OpeningHour) {
	<div class="event-time">
		{ e.StartTime.In(calendar.SwissLoc).Format("15:04") } – { e.EndTime.In(calendar.SwissLoc).Format("15:04") }
	</div>
	<div class="event-content">
		if len(e.Expertise) > 0 {
			Fachperson:
			for _, ex := range e.Expertise {
				<div>{ ex }</div>
			}
		} else {
			geöffnet
		}
	</div>
}

templ calEventBlock(e *models.Event) {
	<div class="event-time">
		{ e.StartTime.Format("15:04") } – { e.EndTime.Format("15:04") }
	</div>
	<div class="event-content">
		{ e.Title }
	</div>
}

templ calendarNavigation(data CalendarData) {
	<div class="cal-navigation">
		<div class="cal-nav-container">
			<button type="button" class="cal-nav-button cal-nav-button-arrow" hx-get={ data.PrevUrl } hx-target="#opening_hours" hx-swap="innerHTML">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
					<!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
					<path d="M236.3 107.1C247.9 96 265 92.9 279.7 99.2C294.4 105.5 304 120 304 136L304 272.3L476.3 107.2C487.9 96 505 92.9 519.7 99.2C534.4 105.5 544 120 544 136L544 504C544 520 534.4 534.5 519.7 540.8C505 547.1 487.9 544 476.3 532.9L304 367.7L304 504C304 520 294.4 534.5 279.7 540.8C265 547.1 247.9 544 236.3 532.9L44.3 348.9C36.5 341.3 32 330.9 32 320C32 309.1 36.5 298.7 44.3 291.1L236.3 107.1z"></path>
				</svg>
			</button>
			<button type="button" class="cal-nav-button" hx-get={ fmt.Sprintf("/calendar/%s/%d", time.Now().Format("2006-01-02"), data.Daycount) } hx-target="#opening_hours" hx-swap="innerHTML">{ data.StartDate.Format("02.01.2006") } - { data.StartDate.AddDate(0,0,data.Daycount-1).Format("02.01.2006") }</button>
			<button type="button" class="cal-nav-button cal-nav-button-arrow" hx-get={ data.NextUrl } hx-target="#opening_hours" hx-swap="innerHTML">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" fill="currentColor">
					<!--!Font Awesome Free v7.2.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
					<path d="M403.7 107.1C392.1 96 375 92.9 360.3 99.2C345.6 105.5 336 120 336 136L336 272.3L163.7 107.2C152.1 96 135 92.9 120.3 99.2C105.6 105.5 96 120 96 136L96 504C96 520 105.6 534.5 120.3 540.8C135 547.1 152.1 544 163.7 532.9L336 367.7L336 504C336 520 345.6 534.5 360.3 540.8C375 547.1 392.1 544 403.7 532.9L595.7 348.9C603.6 341.4 608 330.9 608 320C608 309.1 603.5 298.7 595.7 291.1L403.7 107.1z"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ Calendar(baseUrl string) {
	//	<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js"></script>
	<style>
		:root {
			/* --primary-color: #00ffa8; */
			/* --secondary-color: #d7ff00; */
			/* --tertiary-color: #bd00ff; */
			/* --tertiary-text: white; */
			/* --font-serif: "PT Serif", serif; */
			/* --font-nonserif: "Mosk"; */
		}

		.event-entry {
			padding: 8px 10px;
			/* border-radius: 6px; */
			border-left-width: 3px;
			border-left-style: solid;
			font-size: 0.75rem;
			line-height: 1.4;
		}

		.event-time {
			font-family: var(--font-nonserif);
			font-weight: 700;
			font-size: clamp(0.7rem, 3vw, 1rem);
		}

		.event-content {
			margin-top: 0.2rem;
			font-size: clamp(0.7rem, 3vw, 0.9rem);
		}

		.cal-link {
			text-decoration: none;
			color: var(--tertiary-text);
		}

		.cal-navigation {
			display: grid;
			justify-items: center;
			margin-bottom: 0.8rem;
		}

		.cal-nav-container {
			display: flex;
			gap: 0.4rem;
		}

		.cal-nav-button {
			background-color: var(--primary-color);
			color: var(--tertiary-color);
			font-size: 1.2rem;
			font-weight: 900;
			padding: 0.3rem 0.5rem;
			border: none;
			cursor: pointer;
			font-family: var(--font-nonserif);

			&:hover {
				background-color: var(--tertiary-color);
				color: var(--secondary-color);
			}
		}

		.cal-nav-button-arrow {
			aspect-ratio: 1;
			flex-shrink: 0;
		}

		.cal-nav-button-arrow svg {
			width: 1em;
			height: 1em;
			fill: currentColor;
			display: block;
		}

		.cal-grid {
			font-family: var(--font-serif);
			display: flex;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			--slot-height: max(8px, calc((100vh - 320px) / 56));
		}

		.cal-time-col {
			width: 3.5rem;
			flex-shrink: 0;
		}

		.cal-header-cell {
			height: 2.5rem;
		}

		.cal-time-label {
			font-family: var(--font-nonserif);
			height: var(--slot-height);
			display: flex;
			align-items: flex-start;
			justify-content: flex-end;
			padding-right: 0.5rem;
			font-size: 0.8rem;
			opacity: 0.6;
		}

		.cal-day-col {
			flex: 1;
			min-width: 55px;
			border-left: 1px solid
				color-mix(in oklch, var(--tertiary-color) 20%, transparent);
		}

		.cal-day-today {
			background: repeating-linear-gradient(
				63.435deg,
				white,
				white 9px,
				color-mix(in oklch, var(--tertiary-color) 20%, transparent) 9px,
				color-mix(in oklch, var(--tertiary-color) 20%, transparent) 10px
			);
		}

		.cal-day-header {
			font-family: var(--font-nonserif);
			font-weight: 600;
			height: 2.5rem;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1rem;
			border-bottom: 1px solid
				color-mix(in oklch, var(--tertiary-color) 20%, transparent);
		}

		.cal-day-body {
			position: relative;
			height: calc(56 * var(--slot-height));
			background-image: repeating-linear-gradient(
				to bottom,
				transparent,
				transparent calc(4 * var(--slot-height) - 1px),
				color-mix(in oklch, black 20%, transparent)
					calc(4 * var(--slot-height) - 1px),
				color-mix(in oklch, black 20%, transparent) calc(4 * var(--slot-height))
			);
		}

		.cal-event {
			position: absolute;
			top: calc(var(--start-slot) * var(--slot-height));
			height: calc(var(--duration-slots) * var(--slot-height));
			left: calc(var(--col) / var(--total-cols) * 100%);
			width: calc(100% / var(--total-cols));
			box-sizing: border-box;
			padding: 8px 10px;
			border-left-width: 3px;
			border-left-style: solid;
			font-size: 0.75rem;
			line-height: 1.4;
			overflow: clip;
			overflow-clip-margin: content-box;
		}

		.type-event {
			background: var(--primary-color);
			color: var(--tertiary-color);
			border-color: var(--tertiary-color);

			&:hover {
				background: var(--tertiary-color);
				color: var(--tertiary-text);
			}
			.event-content {
				/* overflow-wrap: break-word; */
				word-break: break-all;
			}
		}

		.type-openinghour {
			background: var(--secondary-color);
			color: var(--tertiary-color);
			border-color: var(--tertiary-color);
		}
	</style>
	<div id="opening_hours" data-baseurl={ fmt.Sprintf("%s/%s/", baseUrl, time.Now().Format("2006-01-02")) }></div>
	<script>
		(function () {
			const el = document.getElementById("opening_hours");
			const calBaseUrl = el.dataset.baseurl.replace(
				/\/\d{4}-\d{2}-\d{2}\/$/,
				"",
			);

			function calcDayCount() {
				return window.innerWidth < 480 ? 3 : 7;
			}

			let currentDayCount = calcDayCount();

			htmx.ajax("GET", el.dataset.baseurl + currentDayCount, {
				target: "#opening_hours",
				swap: "innerHTML",
			});

			let resizeTimer;
			window.addEventListener("resize", function () {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(function () {
					const newDayCount = calcDayCount();
					if (newDayCount === currentDayCount) return;
					currentDayCount = newDayCount;
					const dateEl = document.getElementById("cal-current-date");
					const currentDate =
						(dateEl && dateEl.dataset.date) ||
						el.dataset.baseurl.replace(/\/$/, "").split("/").pop();
					htmx.ajax("GET", calBaseUrl + "/" + currentDate + "/" + newDayCount, {
						target: "#opening_hours",
						swap: "innerHTML",
					});
				}, 150);
			});
		})();
	</script>
}

templ calDetailStyles() {
	<style>
		.cal-event-expandable {
			cursor: default;
			-webkit-tap-highlight-color: transparent;
		}
		.cal-more-hint {
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			padding: 6px 10px;
			font-size: 0.8rem;
			font-style: italic;
			pointer-events: none;
		}
		.cal-popover {
			position: fixed;
			z-index: 100;
			padding: 8px 10px;
			border-left-width: 3px;
			border-left-style: solid;
			font-size: 0.75rem;
			line-height: 1.4;
			pointer-events: none;
			box-sizing: border-box;
			overflow: hidden;
		}
	</style>
	<script>
		(function () {
			var pop = null;
			var activeEl = null;
			var hideTimer = null;

			function scheduleHide() {
				hideTimer = setTimeout(hide, 60);
			}

			function cancelHide() {
				clearTimeout(hideTimer);
			}

			function show(el, force) {
				cancelHide();
				if (pop && activeEl === el) return;
				hide();
				var scrollH = el.scrollHeight;
				var clientH = el.clientHeight;
				if (!force && scrollH <= clientH + 2 && el.scrollWidth <= el.clientWidth + 2)
					return;
				activeEl = el;

				pop = document.createElement("div");
				pop.className = "cal-popover";
				pop.innerHTML = el.innerHTML;
				var hint = pop.querySelector(".cal-more-hint");
				if (hint) hint.remove();

				var cs = getComputedStyle(el);
				pop.style.backgroundColor = cs.backgroundColor;
				pop.style.borderLeftColor = cs.borderLeftColor;
				pop.style.color = cs.color;

				var rect = el.getBoundingClientRect();
				var body = el.closest(".cal-day-body");
				var bodyRect = body ? body.getBoundingClientRect() : rect;
				var dayCol = el.closest(".cal-day-col");
				var colRect = dayCol ? dayCol.getBoundingClientRect() : rect;
				var grid = el.closest(".cal-grid");
				var gridRect = grid ? grid.getBoundingClientRect() : bodyRect;

				pop.style.left = rect.left + "px";
				pop.style.top = rect.top + "px";
				pop.style.width = rect.width + "px";
				pop.style.height = rect.height + "px";

				document.body.appendChild(pop);

				if (el.dataset.url) {
					pop.style.pointerEvents = "auto";
					pop.style.cursor = "pointer";
					pop.addEventListener("mouseenter", cancelHide);
					pop.addEventListener("mouseleave", scheduleHide);
					pop.addEventListener("click", function () {
						window.location.href = el.dataset.url;
					});
				}

				var colW = colRect.width;
				var evtW = rect.width;
				pop.style.minWidth = evtW + "px";
				pop.style.minHeight = rect.height + "px";
				pop.style.maxWidth = colW * 2 + "px";
				pop.style.width = "auto";
				pop.style.height = "auto";
				var popH = pop.offsetHeight;
				var popW = pop.offsetWidth;

				pop.style.width = rect.width + "px";
				pop.style.height = rect.height + "px";
				pop.offsetHeight;

				var dayCols = grid ? grid.querySelectorAll(".cal-day-col") : [];
				var dayIndex = Array.prototype.indexOf.call(dayCols, dayCol);
				var isFirst = dayIndex <= 0;
				var isLast = dayIndex === dayCols.length - 1;

				var evtCenterX = rect.left + rect.width / 2;
				var x;
				if (isFirst) {
					x = rect.left;
				} else if (isLast) {
					x = rect.right - popW;
				} else {
					x = evtCenterX - popW / 2;
				}
				x = Math.max(gridRect.left, Math.min(x, gridRect.right - popW));

				var centerY = rect.top + rect.height / 2;
				var nearTop = centerY - bodyRect.top < popH / 2 + 8;
				var nearBottom = bodyRect.bottom - centerY < popH / 2 + 8;

				var y;
				if (nearTop) {
					y = rect.top;
				} else if (nearBottom) {
					y = rect.bottom - popH;
				} else {
					y = centerY - popH / 2;
				}
				y = Math.max(bodyRect.top, Math.min(y, bodyRect.bottom - popH));

				pop.style.transition =
					"left 0.2s ease, top 0.2s ease, width 0.2s ease, height 0.2s ease, box-shadow 0.2s ease";
				pop.offsetHeight;

				requestAnimationFrame(function () {
					if (!pop) return;
					pop.style.left = x + "px";
					pop.style.top = y + "px";
					pop.style.width = popW + "px";
					pop.style.height = popH + "px";
					pop.style.boxShadow = "0 6px 20px rgba(0,0,0,0.2)";
				});
			}

			function hide() {
				clearTimeout(hideTimer);
				if (pop) {
					pop.remove();
					pop = null;
				}
				activeEl = null;
			}

			function addHint(el) {
				if (el.querySelector(".cal-more-hint")) return;
				var overflows =
					el.scrollHeight > el.clientHeight + 2 ||
					el.scrollWidth > el.clientWidth + 2;
				if (!overflows) return;
				var hint = document.createElement("div");
				hint.className = "cal-more-hint";
				hint.textContent = "» weitere\u2026";
				var cs = getComputedStyle(el);
				hint.style.backgroundColor = cs.backgroundColor;
				el.appendChild(hint);
			}

			function bind(el) {
				if (el.dataset.calBound) return;
				el.dataset.calBound = "1";
				addHint(el);
				el.addEventListener("mouseenter", function () {
					cancelHide();
					show(el);
				});
				el.addEventListener("mouseleave", scheduleHide);
				el.addEventListener("focus", function () {
					show(el);
				});
				el.addEventListener("blur", scheduleHide);
				if (el.dataset.url) {
					el.style.cursor = "pointer";
					el.addEventListener("touchend", function (e) {
						if (!pop) {
							e.preventDefault();
							show(el, true);
						}
					}, { passive: false });
					el.addEventListener("click", function () {
						if (pop) return;
						window.location.href = el.dataset.url;
					});
				}
			}

			function init() {
				document.querySelectorAll(".cal-event-expandable").forEach(bind);
			}
			init();
			new MutationObserver(init).observe(document.body, {
				childList: true,
				subtree: true,
			});
			document.addEventListener(
				"touchstart",
				function (e) {
					if (pop && !pop.contains(e.target)) hide();
				},
				{ passive: true },
			);
		})();
	</script>
}

templ CalendarView(data CalendarData) {
	<span id="cal-current-date" data-date={ data.StartDate.Format("2006-01-02") } hidden></span>
	@calDetailStyles()
	<div class="cal-wrapper" data-prev={ data.PrevUrl } data-next={ data.NextUrl }>
		@calendarNavigation(data)
		<div class="cal-grid">
			<div class="cal-time-col">
				<div class="cal-header-cell"></div>
				for i := range 56 {
					<div class="cal-time-label">
						if i % 4 == 0 {
							{ calendar.CalSlotLabel(i, 8, 15) }
						}
					</div>
				}
			</div>
			for d := range data.Daycount {
				{{ day := data.StartDate.AddDate(0, 0, d) }}
				<div class={ "cal-day-col", templ.KV("cal-day-today", calendar.IsToday(day)) }>
					<div class="cal-day-header">{ calendar.CalDayHeader(day) }</div>
					<div class="cal-day-body">
						for _, entry := range calendar.CalEntriesForDay(data.Entries, day) {
							switch e := entry.(type) {
								case *models.OpeningHour:
									<div
										class={ "cal-event type-openinghour", templ.KV("cal-event-expandable", len(e.Expertise) > 0) }
										style={ calendar.CalEventStyle(entry, 8, 15) }
										if len(e.Expertise) > 0 {
											tabindex="0"
										}
									>
										@calOpeningHour(e)
									</div>
								case *models.Event:
									<div
										class="cal-event type-event cal-event-expandable"
										style={ calendar.CalEventStyle(entry, 8, 15) }
										data-url={ e.URL }
										tabindex="0"
									>
										@calEventBlock(e)
									</div>
							}
						}
					</div>
				</div>
			}
		</div>
		<script>
			(function () {
				const wrapper = document.querySelector(".cal-wrapper");
				if (!wrapper) return;
				let startX = 0;
				wrapper.addEventListener(
					"touchstart",
					function (e) {
						startX = e.touches[0].clientX;
					},
					{ passive: true },
				);
				wrapper.addEventListener(
					"touchend",
					function (e) {
						const diff = startX - e.changedTouches[0].clientX;
						if (Math.abs(diff) < 50) return;
						const url = diff > 0 ? wrapper.dataset.next : wrapper.dataset.prev;
						if (url)
							htmx.ajax("GET", url, {
								target: "#opening_hours",
								swap: "innerHTML",
							});
					},
					{ passive: true },
				);
			})();
		</script>
	</div>
}
