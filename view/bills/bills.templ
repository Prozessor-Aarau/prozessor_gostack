package bills

import (
"fmt"
"github.com/faebut/prozessor_gostack/internal/models"
"github.com/faebut/prozessor_gostack/internal/render"
"github.com/faebut/prozessor_gostack/view/layout"
"github.com/faebut/prozessor_gostack/view/ui"
"golang.org/x/text/cases"
"golang.org/x/text/language"
"strconv"
)

templ Bills(visitor models.Visitor, categories []string) {
@layout.App(true, visitor) {
<div class="prose mb-10">
  <h1>Rechnungen</h1>
</div>
<div id="content">
  @billFilter(categories)
  <div id="billsList" hx-get="/admin/billing/list" hx-trigger="load"></div>
</div>
}
}

templ billFilter(categories []string) {
{{ prm := ctx.Value("permission").(models.Role) }}
<div class="border-base-content border-opacity-20 border rounded-md dark:rounded-lg bg-base-100 my-4 p-4">
  <h2 class="font-bold text-xl mb-3">Suchfilter</h2>
  <form id="filterForm" novalidate>
    <div class="grid grid-cols-4 gap-5 items-center">
      @ui.CSRF()
      <label class="input input-bordered flex items-center gap-2 col-span-full">
        <span class="text-3xl i-mdi-magnify"></span>
        <input type="text" id="filter_string" name="filter_string" class="grow"
          placeholder="Suche nach Rechnungsnummer, Vorname, Familienname ..." />
        <!-- how to implement this button? should reset field -->
        <button id="fieldreset" class="ml-3 btn btn-neutral btn-outline btn-xs btn-circle">
          <span class="i-mdi-close"></span>
        </button>
      </label>
      <label class="form-control w-full max-w-xs col-span-full md:col-span-1">
        <select name="payment" id="inuse" class="select select-bordered">
          <option value="all">Bezahlstatus (alle)</option>
          <option value="unpaid">offen</option>
          <option value="paid">bezahlt</option>
        </select>
      </label>
      <label class="form-control w-full max-w-xs col-span-full md:col-span-2">
        <select name="type" id="type" class="select select-bordered">
          <option value="all" selected>Rechnungstyp (alle)</option>
          for _, c := range categories {
          <option value={ c }>{ cases.Title(language.English, cases.NoLower).String(c) }</option>
          }
        </select>
      </label>
      <div class="col-span-full md:col-span-1 grid grid-cols-2 justify-items-center justify-around gap-3">
        <button type="submit" hx-post="/admin/billing/list" hx-target="#billsList"
          class="btn btn-success btn-outline btn-circle"><span class="i-mdi-magnify text-xl"></span></button>
        <a href="/admin/billing" class="btn btn-error btn-outline btn-circle">
          <span class="i-mdi-close text-xl"></span>
        </a>
      </div>
    </div>
  </form>
  if prm.AddFinances {
  <div class="border-base-content border-opacity-50 border-dashed border-t mt-4 pt-4">
    <button type="button" class="btn btn-secondary btn-disabled" hx-get="/admin/billing/create" hx-target="#content">
      Rechnung
      erstellen
    </button>
  </div>
  }
</div>
<!-- For the switches -->
<script>
  searchField = document.querySelector("#filter_string")

  document.getElementById("fieldreset").addEventListener("click", function (event) {
    event.preventDefault();
    searchField.value = "";
  });
</script>
}

templ BillsList(bills []models.BillData, pages int, onpage int, filter string) {
{{ prm := ctx.Value("permission").(models.Role) }}
if len(bills) > 0 {
for _, b := range bills {
<div id={ "billdiv_" + strconv.Itoa(b.ID) }
  class="hover:bg-base-200 cursor-pointer grid grid-cols-8 text-sm p-3 py-4 items-center gap-3 border-dashed border-b border-base-content border-opacity-50">
  <div class="col-span-1">{ strconv.Itoa(b.ID) }</div>
  <div class="col-span-3 md:col-span-2">{ b.CreatedOn.Format("02.01.2006") }</div>
  <div class="col-span-4 md:col-span-2">{ b.Purpose }</div>
  <div class="col-span-4 md:col-span-2">{ b.FirstName } { b.FamilyName }</div>
  <div class="col-span-4 md:col-span-1 text-right">
    if b.Paid {
    <span id={ "price_" + strconv.Itoa(b.ID) } class="text-success">
      { strconv.FormatFloat(b.Amount, 'f', 2, 64) }
    </span>
    } else {
    <span id={ "price_" + strconv.Itoa(b.ID) } class="text-error">{ strconv.FormatFloat(b.Amount, 'f', 2, 64) } </span>
    }
  </div>
  <div class="col-span-full md:col-span-7">
    { b.Infos }
  </div>
  <form class="col-span-full md:col-span-1 flex gap-3 justify-center md:justify-end items-center">
    @ui.CSRF()
    <input name="id" type="hidden" value={ strconv.Itoa(b.ID) } />
    <!-- edit button -->
    <a class={ "btn btn-sm btn-circle btn-disabled" , templ.KV("btn-disabled", !prm.EditFinances) }
      hx-get={ "/admin/billing/" + strconv.Itoa(b.ID) } hx-target="#content">
      <span class="i-mdi-lead-pencil"></span>
    </a>
    <!-- download button -->
    <a class="btn btn-sm btn-circle btn-info" href={ templ.URL("/static/bills/" + b.Purpose + "/" + b.FileName) }
      target="_blank">
      <span class="i-mdi-download"></span>
    </a>
    <!-- change payment status -->
    <div id={ "paybutton_" + strconv.Itoa(b.ID) }>
      @PayButton(b)
    </div>
    <!-- delete button -->
    <a class={ "btn btn-sm btn-circle btn-error btn-outline" , templ.KV("btn-disabled", !prm.EditFinances) }
      hx-delete={ "/admin/billing/" + strconv.Itoa(b.ID) } hx-target={ "#billdiv_" + strconv.Itoa(b.ID) }
      hx-swap="outerHTML" hx-confirm={ fmt.Sprintf("Rechnung Nummer %d wirklich für immer löschen?", b.ID) }
      name="deleteButton">
      <span class="i-mdi-delete"></span>
    </a>
  </form>
</div>
}
@pagination(pages, onpage, filter)
} else {
<div class="my-10">
  @layout.Warning("keine Suchergebnisse")
</div>
}
<!-- this script is needed for the delete button to send the CSRF-Token -->
if len(bills) > 0 {
<script type="text/javascript">
  document.getElementsByName("deleteButton").forEach((button) => {
    button.addEventListener('htmx:configRequest', (event) => {
      event.detail.headers['X-CSRF-Token'] = document.getElementById('csrf_token').value
    })
  })
</script>
}
}

templ PayButton(b models.BillData) {
{{ prm := ctx.Value("permission").(models.Role) }}
if b.Paid {
<!-- price -->
<span id={ "price_" + strconv.Itoa(b.ID) } class="text-success" hx-swap-oob={ "outerHTML:#price_" + strconv.Itoa(b.ID)
  }>{ strconv.FormatFloat(b.Amount, 'f', 2, 64) } </span>
<!-- button -->
<a class={ "btn btn-sm btn-circle btn-error" , templ.KV("btn-disabled", !prm.EditFinances) }
  hx-post="/admin/billing/payment" hx-target={ "#paybutton_" + strconv.Itoa(b.ID) }>
  <span class="i-mdi-cash-remove"></span>
</a>
} else {
<!-- price -->
<span id={ "price_" + strconv.Itoa(b.ID) } class="text-error" hx-swap-oob={ "outerHTML:#price_" + strconv.Itoa(b.ID) }>
  {
  strconv.FormatFloat(b.Amount, 'f', 2, 64) }
</span>
<!-- button -->
<a class={ "btn btn-sm btn-circle btn-success" , templ.KV("btn-disabled", !prm.EditFinances) }
  hx-post="/admin/billing/payment" hx-target={ "#paybutton_" + strconv.Itoa(b.ID) }>
  <span class="i-mdi-cash-check"></span>
</a>
}
}

templ pagination(pages int, onpage int, filter string) {
{{ pagesslice := render.Iterate(pages) }}
<div class="grid justify-items-center">
  <div class="join pt-6">
    <button class={ "join-item btn" , templ.KV("btn-disabled", onpage==1) } hx-target="#billsList"
      hx-get={ "/admin/billing/list?page=" + strconv.Itoa(onpage-1) + filter }>«</button>
    for _, p := range pagesslice {
    switch p {
    case 1, pages, onpage, onpage+1, onpage-1:
    <button class={ "join-item btn" , templ.KV("btn-primary", onpage==p) } hx-target="#billsList"
      hx-get={ "/admin/billing/list?page=" + strconv.Itoa(p) + filter }>{ strconv.Itoa(p) }</button>
    case onpage+2, onpage-2:
    <button class="join-item btn btn-disabled">.</button>
    }
    }
    <button class={ "join-item btn" , templ.KV("btn-disabled", onpage==pages) } hx-target="#billsList"
      hx-get={ "/admin/billing/list?page=" + strconv.Itoa(onpage+1) + filter }>»</button>
  </div>
</div>
}
