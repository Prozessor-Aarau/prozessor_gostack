package newsletter

import (
"github.com/faebut/prozessor_gostack/internal/models"
"github.com/faebut/prozessor_gostack/view/layout"
)

templ NewsletterPreview(visitor models.Visitor, visitors []models.Visitor, template string) {
@layout.App(true, visitor) {
<!-- {{ prm := ctx.Value("permission").(models.Role) }} -->
<div class="prose mb-10">
  <h1>Newsletter</h1>
</div>
<div id="content">
  <div class="grid grid-cols-2 items-center gap-3">
    <div class="prose col-span-full">
      <h2>Newsletter versenden</h2>
    </div>
    <div class="prose col-span-full">
      <h3>Liste Empfänger:innen</h3>
    </div>
    <div class="col-span-full overflow-x-auto w-full">
      <table class="table table-pin-cols table-pin-rows table-xs">
        <!-- head -->
        <thead>
          <tr>
            <th>Name Besucher:in</th>
            <th>Mitglied</th>
            <th>E-Mail</th>
          </tr>
        </thead>
        <tbody>
          <!-- start row -->
          for _, v := range visitors {
          <tr>
            <td>
              <input type="hidden" name={ v.ID } value="true" />
              { v.FirstName } { v.FamilyName }
            </td>
            <td>
              if v.Ressort.ID > 0 {
              <span class="text-success">Mitglied</span>
              }
            </td>
            <td>
              { v.Email }
            </td>
          </tr>
          }
          <!-- end row -->
        </tbody>
        <!-- foot -->
      </table>
    </div>
    if len(visitors)>0 {
    <button class="btn btn-success" hx-post="/admin/reminder/confirm" hx-target="#content">Reminder versenden</button>
    }
    <a href="/admin/reminder" class="btn btn-warning">Abbrechen</a>
  </div>
  <div id="preview" class="my-8">
    <div class="prose mb-6">
      <h2>Preview Newsletter</h2>
    </div>
    <div class="mockup-window bg-base-300 border w-full">
      <div class="flex justify-center p-4" data-theme="light">
        @templ.Raw(template)
      </div>
    </div>
  </div>
</div>
}
}
