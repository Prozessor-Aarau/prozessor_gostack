package admin

import (
	"github.com/faebut/prozessor_gostack/internal/models"
	"github.com/faebut/prozessor_gostack/view/layout"
	"github.com/faebut/prozessor_gostack/view/ui"
	"slices"
	"strconv"
)

templ Admin(visitor models.Visitor, ateliers []models.Atelier) {
	@layout.App(true, visitor) {
		<div class="prose">
			<h2>Willkommen in der prozessor Datenbank, { visitor.FirstName }!</h2>
			<p>
				Du kannst dein Profil rechts oben bei deinen Initialen bearbeiten oder dich ausloggen.
			</p>
		</div>
		@chooseExpertise(visitor, ateliers)
	}
}

templ chooseExpertise(visitor models.Visitor, ateliers []models.Atelier) {
	<div class="prose">
		<h3 class="mt-4"><span class="text-success">[NEU!]</span> Expertise auswählen</h3>
		<p>Wähle aus den verschiedenen Werkbereichen aus, damit im Kalendar die entsprechende Fachperson angezeigt wird, wenn du eine Aufsicht übernimmst.</p>
		<p>Als Fachperson gilt, wer sich in einem Werkbereich soweit auskennt, dass er/sie unkundige Personen anleiten, die Gerätschaften zeigen und entsprechend der Sicherheitsbestimmungen instruieren kann.</p>
	</div>
	<form
		class="grid grid-cols-1 items-center justify-items-center"
		hx-post="/admin/expertise"
		hx-swap="outerHTML"
		hx-target="#expert_button"
		novalidate
	>
		@ui.CSRF()
		<fieldset class="fieldset w-full">
			<legend class="fieldset-legend">Werkbereiche mit Expertise</legend>
			<div class="not-prose grid grid-cols-2 sm:grid-cols-3 gap-5 mb-4 mx-4 mt-1">
				for _, a := range ateliers {
					<label class="fieldset-label gap-3">
						<input
							name={ strconv.Itoa(a.ID) }
							type="checkbox"
							class="checkbox"
							checked?={ 
              slices.Contains(visitor.Expertise, a.ID) }
						/>
						{ a.AtelierName }
					</label>
				}
			</div>
		</fieldset>
		@ExpertUpdateButton(false)
	</form>
}

templ ExpertUpdateButton(success bool) {
	<button id="expert_button" type="submit" class={ "btn", templ.KV("btn-primary", !success), templ.KV("btn-success", success) }>
		if success {
			Expertise gespeichert
		} else {
			Expertise speichern
		}
	</button>
}
