# Application is in Production
PRODUCTION=true
# Use template cache
CACHE=true
# Port
PORT=:4000
# Database host
DBHOST=
# Database name
DBNAME=
# Database user
DBUSER=
# Database password
DBPASS=
# Database port
DBPORT=5432
# Database ssl settings (disable, prefer, require)
DBSSL=disable
# Slack API Key
SLACKTOKEN=xoxb-
# Site base URL
BASE_URL=http://localhost:4000/
# URL of LabelPrinter
QR_PRINT_SERVER=localhost:8013

## Mail
# SMTP Mailserver host address
SMTP_HOST=
# SMTP Port
SMTP_PORT=587
# SMTP Username
SMTP_USERNAME=
# SMTP Password
SMTP_PASSWORD=
# use encryption true/false
SMTP_ENCRYPTION=true

## Migrations
# these have to be set manually
# this file won't be read for goose
# Database driver
GOOSE_DRIVER=postgres
# database connection string
GOOSE_DBSTRING=postgresql://postgres:mysecretpassword@localhost:5432/postgres
# directory containing migration files
GOOSE_MIGRATION_DIR=./migrations

## Billing information
BILL_IBAN=
BILL_NAME=
BILL_STREET=
BILL_NUMBER=
BILL_ZIP=
BILL_PLACE=
BILL_COUNTRY=
BILL_CURRENCY=
