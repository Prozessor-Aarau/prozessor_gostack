# Application is in Production
PRODUCTION=true
# Use template cache
CACHE=true
# Database host
DBHOST=
# Database name
DBNAME=
# Database user
DBUSER=
# Database password
DBPASS=
# Database port
DBPORT=5432
# Database ssl settings (disable, prefer, require)
DBSSL=disable
# Slack API Key
SLACKTOKEN=xoxb-
# Site base URL
BASE_URL=http://localhost:4000/

## Migrations
# these have to be set manually
# this file won't be read for goose
# Database driver
GOOSE_DRIVER=postgres
# database connection string
GOOSE_DBSTRING=postgresql://postgres:mysecretpassword@localhost:5432/postgres
# directory containing migration files
GOOSE_MIGRATION_DIR=./migrations

